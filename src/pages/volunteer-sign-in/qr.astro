---
import QrPoster from '../../components/QrPoster.astro';
import PageLayout from '../../layouts/PageLayout.astro';
---

<PageLayout
  title="Volunteer Sign-in QR Code — The Forktree Project"
  description="Print a QR code for The Forktree Project volunteer sign-in page."
  headerVariant="dark"
  norobots={true}
>
  <QrPoster
    kicker="Welcome to Forktree"
    title="Volunteer sign in & out"
    instruction="Scan the QR code with your phone camera to sign in when you arrive, and scan it again to sign out when you leave."
    image="/images/volunteer-sign-in-qr.svg"
    alt="QR code for the Forktree volunteer sign-in page"
    path="/volunteer-sign-in"
    backLabel="Back to sign-in form"
  />
</PageLayout>
