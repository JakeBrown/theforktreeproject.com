---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="The Forktree Project" description="The Forktree Project is a registered charity re-wilding a 133-acre former pastoral property in South Australia's Fleurieu Peninsula.">
  <Header />

  <!-- Banner Section -->
  <section id="banner" class="index-section index-section--banner">
    <div class="index-section__bg" data-parallax></div>
    <div class="index-section__content index-section__content--center">
      <div class="banner-text">
        <h1>Re-wilding.</h1>
        <h1>It&rsquo;s in our nature.</h1>
      </div>
    </div>
  </section>

  <!-- Story 1 - Stats -->
  <section id="story-1" class="index-section index-section--story1">
    <div class="index-section__bg" data-parallax></div>
    <div class="index-section__content index-section__content--right">
      <div class="story-text">
        <h2>Global extinction rates of plants and animals are 100 times higher because of us.</h2>
        <h2>Australia is one of seven countries responsible for more than half of global biodiversity loss.</h2>
      </div>
    </div>
  </section>

  <!-- Story 2 - Hope -->
  <section id="story-2" class="index-section index-section--story2">
    <div class="index-section__bg" data-parallax></div>
    <div class="index-section__content index-section__content--left">
      <div class="story-text">
        <h2>If we planted trees on all the suitable spare land that existed globally, we could store over 200 billion tonnes of carbon and buy 20 years in the fight against climate change.</h2>
        <h2>Australia is one of the top countries globally with such tree-planting potential.</h2>
      </div>
    </div>
  </section>

  <!-- About: What is The Forktree Project? -->
  <section class="home-about home-about--plain home-about--center">
    <div class="home-about__inner">
      <p class="home-about__kicker">About</p>
      <h2 class="home-about__lead">What is The Forktree Project?</h2>
      <p class="home-about__body">The Forktree Project is a registered charity dedicated to widescale habitat and biodiversity restoration throughout the Hills &amp; Fleurieu region and beyond, and to the education, engagement and empowerment of young people and the wider community in habitat restoration.</p>
    </div>
  </section>

  <!-- About: Our Vision -->
  <section class="home-about home-about--olive home-about--left">
    <div class="home-about__inner">
      <h2 class="home-about__lead home-about__lead--light">Our Vision</h2>
      <ul class="home-about__list home-about__list--olive">
        <li><strong>A fully restored and thriving biodiversity hotspot</strong> on the 54-hectare exemplar Forktree site</li>
        <li><strong>Restored and enriched biodiversity across the region and beyond</strong>, including on private land</li>
        <li><strong>An enthused, empowered and engaged younger generation</strong> of environmental stewards</li>
        <li><strong>Enhanced wellbeing</strong> amongst young people and the wider community as a result of purposeful connection with nature</li>
      </ul>
    </div>
  </section>

  <!-- About: Goals -->
  <section class="home-about home-about--plain home-about--right">
    <div class="home-about__inner">
      <h2 class="home-about__lead">Our Goals</h2>
      <p class="home-about__body">The Forktree Project works to achieve this vision via:</p>
      <ol class="home-about__goals">
        <li>the ongoing <a href="/goals"><strong>ecological restoration</strong></a> of the main Forktree site &mdash; an extensively cleared 54ha former pastoral property on the Fleurieu Peninsula &mdash; as an example of what can be achieved</li>
        <li>the work of its <a href="/nursery"><strong>native plant nursery</strong></a> and rare seed orchard to support region-wide ecological restoration</li>
        <li>bespoke <a href="/education1"><strong>experiential education</strong></a> programs for school groups and tertiary education students</li>
        <li>engagement of the wider community through on-site <a href="/team-days"><strong>Team Days</strong></a> and community <a href="/get-involved"><strong>volunteering</strong></a> opportunities</li>
      </ol>
    </div>
  </section>

  <!-- About: Team -->
  <section class="home-about home-about--olive home-about--center">
    <div class="home-about__inner">
      <h2 class="home-about__lead home-about__lead--light">The Forktree Team</h2>

      <div class="home-about__bio">
        <h3 class="home-about__bio-name home-about__bio-name--light">Tim Jarvis AM</h3>
        <p class="home-about__bio-role">Founder and CEO</p>
        <p class="home-about__body home-about__body--light">Tim Jarvis AM is an environmental scientist, author, filmmaker and adventurer with Masters degrees in environmental science and environmental law. He is committed to practical solutions to climate change and biodiversity loss. Tim was appointed a Member of the Order of Australia (AM) in 2010 for services to the environment, exploration and community, named Australian Geographic&rsquo;s Conservationist of the Year in 2016, and recognised as South Australia&rsquo;s Australian of the Year in 2024. A believer in deeds over words, he sees the Forktree Project as a powerful example of what purposeful action can achieve.</p>
      </div>

      <div class="home-about__bio">
        <h3 class="home-about__bio-name home-about__bio-name--light">Elizabeth Blumer</h3>
        <p class="home-about__bio-role">COO; Head of Education and Community Outreach</p>
        <p class="home-about__body home-about__body--light">Elizabeth Blumer is a qualified, registered teacher with more than 15 years&rsquo; experience in middle and high school education, alongside governance experience in educational wellbeing. She holds postgraduate qualifications in Education Wellbeing and Positive Mental Health. Elizabeth brings together her pedagogical experience and her background in writing and editing to lead the development of the Forktree Project Education Program. She is energised by the project&rsquo;s educational and wellbeing potential &mdash; and is, of course, an enthusiastic tree&#8209;planter.</p>
      </div>

      <p class="home-about__thanks home-about__body--light">The Forktree Project is grateful for the generous efforts of many volunteers. Their support is key to the project&rsquo;s continued success &mdash; our heartfelt thanks to them all.</p>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  /* Index Sections */
  .index-section {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--color-text-light);
    overflow: hidden;
  }

  /* Parallax background layer — translated by JS */
  .index-section__bg {
    position: absolute;
    inset: -20% 0; /* 20% extra top/bottom for parallax travel room */
    background-size: cover;
    background-position: center;
    will-change: transform;
    z-index: 0;
  }

  .index-section::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* Banner */
  .index-section--banner {
    min-height: 100vh;
    background-color: #000000;
  }

  .index-section--banner .index-section__bg {
    background-image: url('/images/hero/home-banner.jpg');
  }

  .index-section--banner::before {
    background:
      radial-gradient(ellipse 80% 50% at 50% 45%, rgba(0, 0, 0, 0.35) 0%, transparent 100%),
      rgba(0, 0, 0, 0.25);
  }

  /* Story 1 */
  .index-section--story1 {
    min-height: 85vh;
    background-color: #1a1a1a;
  }

  .index-section--story1 .index-section__bg {
    background-image: url('/images/hero/home-story1.jpg');
  }

  .index-section--story1::before {
    background:
      radial-gradient(ellipse 60% 60% at 70% 50%, rgba(0, 0, 0, 0.35) 0%, transparent 100%),
      rgba(0, 0, 0, 0.3);
  }

  /* Story 2 */
  .index-section--story2 {
    min-height: 100vh;
    background-color: #1a1a1a;
  }

  .index-section--story2 .index-section__bg {
    background-image: url('/images/hero/home-story2.jpg');
  }

  .index-section--story2::before {
    background:
      radial-gradient(ellipse 60% 60% at 30% 50%, rgba(0, 0, 0, 0.35) 0%, transparent 100%),
      rgba(0, 0, 0, 0.3);
  }

  /* Content Layout */
  .index-section__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1600px;
    padding: 180px 100px;
  }

  .index-section__content--center {
    display: flex;
    justify-content: center;
    text-align: center;
  }

  .index-section__content--right {
    display: flex;
    justify-content: flex-end;
  }

  .index-section__content--left {
    display: flex;
    justify-content: flex-start;
  }

  .banner-text {
    max-width: 750px;
    position: relative;
    padding: 1rem 1.5rem;
  }

  .banner-text h1 {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 8.5vw, 110px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: normal;
    color: white;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.7), 0 0 30px rgba(0, 0, 0, 0.4);
  }

  .story-text {
    max-width: 50%;
    position: relative;
    padding: 1rem 1.5rem;
  }

  .story-text h2 {
    font-family: var(--font-heading);
    font-size: clamp(0.85rem, 1.6vw, 20px);
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.04em;
    color: white;
    margin-bottom: 2rem;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.7), 0 0 30px rgba(0, 0, 0, 0.4);
  }

  .story-text h2:last-child {
    margin-bottom: 0;
  }

  /* CTA Button */
  .index-section__cta {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0 100px 80px;
  }

  .btn--cta {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: white;
    border: 2px solid white;
    padding: 13px 26px;
    text-decoration: none;
    transition: all var(--transition-normal);
  }

  .btn--cta:hover {
    background-color: white;
    color: #000;
  }

  /* About sections (Home ∪ About) */
  .home-about {
    position: relative;
    padding: 100px 60px;
  }

  .home-about--plain {
    background-color: #fff;
    color: var(--color-text);
  }

  .home-about--olive {
    background-color: #3a4a2a;
    color: rgba(255, 255, 255, 0.9);
  }

  .home-about__inner {
    max-width: 1000px;
    margin: 0 auto;
  }

  .home-about--left .home-about__inner {
    margin-left: 0;
    margin-right: auto;
  }

  .home-about--right .home-about__inner {
    margin-left: auto;
    margin-right: 0;
  }

  .home-about--center {
    text-align: center;
  }

  .home-about__kicker {
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-text);
    margin: 0 0 1rem;
  }

  .home-about--olive .home-about__kicker {
    color: rgba(255, 255, 255, 0.55);
  }

  .home-about__lead {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    font-weight: 700;
    line-height: 1.35;
    color: #1a1a1a;
    margin: 0 0 1.5rem;
  }

  .home-about__lead--light {
    color: #fff;
  }

  .home-about__body {
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    line-height: 1.7;
    color: #444;
    margin: 0 0 1rem;
  }

  .home-about__body--light {
    color: rgba(255, 255, 255, 0.85);
  }

  .home-about__list {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    text-align: left;
  }

  .home-about__list li {
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    line-height: 1.7;
    margin-bottom: 0.75rem;
    padding-left: 1.25rem;
    position: relative;
  }

  .home-about__list li::before {
    content: '\2022';
    position: absolute;
    left: 0;
    color: #00A651;
  }

  .home-about__list--olive li {
    color: rgba(255, 255, 255, 0.85);
  }

  .home-about__goals {
    list-style: decimal outside;
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    line-height: 1.7;
    color: #444;
    padding-left: 1.75rem;
    margin: 0.5rem 0 0;
    text-align: left;
  }

  .home-about__goals li::marker {
    color: #00A651;
    font-weight: 700;
  }

  .home-about__goals li {
    margin-bottom: 0.75rem;
  }

  .home-about__goals a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: rgba(0, 166, 81, 0.5);
    text-underline-offset: 3px;
  }

  .home-about__goals a:hover {
    text-decoration-color: #00A651;
  }

  .home-about__bio {
    text-align: left;
    max-width: 820px;
    margin: 0 auto 2.5rem;
  }

  .home-about--center .home-about__bio:last-of-type {
    margin-bottom: 2rem;
  }

  .home-about__bio-name {
    font-family: var(--font-heading);
    font-size: clamp(1.15rem, 1.6vw, 1.35rem);
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
  }

  .home-about__bio-name--light {
    color: #fff;
  }

  .home-about__bio-role {
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin: 0.35rem 0 1rem;
  }

  .home-about--plain .home-about__bio-role {
    color: rgba(0, 0, 0, 0.5);
  }

  .home-about__thanks {
    max-width: 820px;
    margin: 0 auto;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    font-style: italic;
    text-align: left;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .index-section {
      background-attachment: scroll;
    }

    .index-section__content {
      padding: 100px 30px;
    }

    .index-section__content--right,
    .index-section__content--left {
      justify-content: center;
    }

    .story-text {
      max-width: 100%;
      text-align: center;
    }

    .index-section__cta {
      padding: 0 30px 60px;
    }

    .home-about {
      padding: 70px 30px;
    }

    .home-about--left .home-about__inner,
    .home-about--right .home-about__inner {
      margin: 0 auto;
    }
  }
</style>

<script>
  const speed = 0.4; // 0 = no movement, 1 = moves with scroll
  const bgs = document.querySelectorAll('[data-parallax]');
  
  function updateParallax() {
    for (const bg of bgs) {
      const section = bg.parentElement;
      if (!section) continue;
      const rect = section.getBoundingClientRect();
      const viewH = window.innerHeight;
      // Only update when section is in view
      if (rect.bottom < 0 || rect.top > viewH) continue;
      // Progress: 0 when section enters bottom, 1 when exits top
      const progress = (viewH - rect.top) / (viewH + rect.height);
      // Translate from -20% to +20% of section height (matches inset: -20%)
      const translate = (progress - 0.5) * speed * rect.height;
      (bg as HTMLElement).style.transform = `translate3d(0, ${translate}px, 0)`;
    }
  }

  // Use rAF for smooth updates
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => {
        updateParallax();
        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });

  // Initial position
  updateParallax();
</script>
