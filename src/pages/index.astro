---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="The Forktree Project" description="The Forktree Project is a registered charity re-wilding a 133-acre former pastoral property in South Australia's Fleurieu Peninsula.">
  <Header />

  <!-- Banner Section -->
  <section id="banner" class="index-section index-section--banner">
    <div class="index-section__bg" data-parallax></div>
    <div class="index-section__content index-section__content--center">
      <div class="banner-text">
        <h1>Re-wilding.</h1>
        <h1>It&rsquo;s in our nature.</h1>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .index-section {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--color-text-light);
    overflow: hidden;
  }

  .index-section__bg {
    position: absolute;
    inset: -20% 0;
    background-size: cover;
    background-position: center;
    will-change: transform;
    z-index: 0;
  }

  .index-section::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .index-section--banner {
    min-height: 100vh;
    background-color: #2a3a2a;
  }

  .index-section--banner .index-section__bg {
    background-image: url('/images/education/edu-hero-aerial.jpg');
  }

  .index-section--banner::before {
    background:
      radial-gradient(ellipse 80% 50% at 50% 45%, rgba(0, 0, 0, 0.35) 0%, transparent 100%),
      rgba(0, 0, 0, 0.35);
  }

  .index-section__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1600px;
    padding: 180px 100px;
    display: flex;
    justify-content: center;
    text-align: center;
  }

  .banner-text {
    max-width: 750px;
    padding: 1rem 1.5rem;
  }

  .banner-text h1 {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 8.5vw, 110px);
    font-weight: 700;
    line-height: 1.1;
    color: white;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.7), 0 0 30px rgba(0, 0, 0, 0.4);
  }

  @media (max-width: 768px) {
    .index-section__content {
      padding: 100px 30px;
    }
  }
</style>

<script>
  const speed = 0.4;
  const bgs = document.querySelectorAll('[data-parallax]');

  function updateParallax() {
    for (const bg of bgs) {
      const section = bg.parentElement;
      if (!section) continue;
      const rect = section.getBoundingClientRect();
      const viewH = window.innerHeight;
      if (rect.bottom < 0 || rect.top > viewH) continue;
      const progress = (viewH - rect.top) / (viewH + rect.height);
      const translate = (progress - 0.5) * speed * rect.height;
      (bg as HTMLElement).style.transform = `translate3d(0, ${translate}px, 0)`;
    }
  }

  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => {
        updateParallax();
        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });

  updateParallax();
</script>
