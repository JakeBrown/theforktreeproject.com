---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="Get Involved — The Forktree Project" description="Find out how to support The Forktree Project through volunteering, in-kind support or tax deductible donation.">

  <!-- Hero -->
  <section class="join-hero" style="background-color: #2a3a2a;">
    <div class="join-hero__content">
      <h1>Get Involved</h1>
      <div class="join-hero__text">
        <p>The Forktree Project is a charity registered with the Australian Charities and Not for Profits Commission (ACNC).</p>
        <p>To find out more about how to support the Project, whether via volunteering, in-kind support or tax deductible donation, or to enquire about The Forktree Project Education Program, please get in touch.</p>
      </div>
      <p class="join-hero__cta-label">Email us for more information</p>
      <a href="mailto:hello@theforktreeproject.com?subject=Forktree%20Website%20Enquiry" class="join-hero__cta">
        hello@theforktreeproject.com
      </a>
    </div>
  </section>

</PageLayout>

<style>
  .join-hero {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-light);
    overflow: hidden;
  }

  .join-hero::before {
    content: '';
    position: absolute;
    /* expand past edges so the blur doesn't show a soft halo */
    inset: -30px;
    background-image: url('/images/join-us/join-hero.jpg');
    background-size: cover;
    background-position: center;
    filter: blur(6px) brightness(0.4);
    z-index: 1;
  }

  .join-hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 700px;
    padding: 180px 30px 100px;
  }

  .join-hero h1 {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    margin-bottom: var(--space-md);
  }

  .join-hero__text p {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.7;
    opacity: 0.9;
    margin-bottom: 1rem;
  }

  .join-hero__cta-label {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    opacity: 0.7;
    margin-bottom: 0.75rem;
  }

  .join-hero__cta {
    display: inline-block;
    margin-top: var(--space-lg);
    padding: 1rem 2.5rem;
    font-family: var(--font-heading);
    font-size: clamp(1rem, 2vw, 1.3rem);
    font-weight: 600;
    letter-spacing: 1px;
    color: white;
    border: 2px solid rgba(255, 255, 255, 0.6);
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .join-hero__cta:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: white;
  }

  @media (max-width: 768px) {
    .join-hero {
      background-attachment: scroll;
    }
  }
</style>
