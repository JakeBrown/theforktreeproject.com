---
import PageLayout from '../layouts/PageLayout.astro';
import { journalTags } from '../data/journalTags';

const tagLabels = Object.fromEntries(journalTags.map((tag) => [tag.slug, tag.label]));
const initialQuery = Astro.url.searchParams.get('q') || '';
---

<PageLayout title="Search — The Forktree Project" description="Search the Forktree Project journal." headerVariant="dark">
  <section class="search-page">
    <div class="container--narrow">
      <header class="search-page__header">
        <h1>Search the Forktree Story</h1>
        <p>Search journal posts by idea, activity, species, partner, or place. Semantic results are shown when the journal index is available.</p>
      </header>

      <form class="search-form" id="journal-search-form" role="search">
        <label class="sr-only" for="journal-search-input">Search the journal</label>
        <input
          id="journal-search-input"
          name="q"
          type="search"
          value={initialQuery}
          placeholder="Try “water management”, “butterflies”, or “school visits”"
          autocomplete="off"
        />
        <button type="submit">Search</button>
      </form>

      <p class="search-status" id="journal-search-status" aria-live="polite"></p>
      <div class="search-results" id="journal-search-results"></div>
    </div>
  </section>
</PageLayout>

<script define:vars={{ initialQuery, tagLabels }}>
  const form = document.getElementById('journal-search-form');
  const input = document.getElementById('journal-search-input');
  const status = document.getElementById('journal-search-status');
  const resultsEl = document.getElementById('journal-search-results');

  const formatDate = (date) => {
    if (!date) return '';
    return new Date(date).toLocaleDateString('en-AU', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    });
  };

  const escapeHtml = (value) => String(value || '')
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#039;');

  const renderTags = (tags = []) => tags
    .map((tag) => `<span class="search-result__tag">${escapeHtml(tagLabels[tag] || tag)}</span>`)
    .join('');

  const renderResults = (results) => {
    resultsEl.innerHTML = results.map((result) => `
      <article class="search-result">
        <a href="${escapeHtml(result.href)}" class="search-result__link">
          ${result.image ? `<img src="${escapeHtml(result.image)}" alt="" loading="lazy" class="search-result__image" />` : ''}
          <div class="search-result__body">
            <h2>${escapeHtml(result.title)}</h2>
            ${result.date ? `<time datetime="${escapeHtml(result.date)}">${escapeHtml(formatDate(result.date))}</time>` : ''}
            <p>${escapeHtml(result.snippet || result.excerpt || '')}</p>
          </div>
        </a>
        ${result.tags?.length ? `<div class="search-result__tags">${renderTags(result.tags)}</div>` : ''}
      </article>
    `).join('');
  };

  const runSearch = async (query, updateUrl = true) => {
    const trimmed = query.trim();
    if (!trimmed) {
      status.textContent = 'Enter a search term to search the journal.';
      resultsEl.innerHTML = '';
      return;
    }

    status.textContent = 'Searching journal…';
    resultsEl.innerHTML = '';

    if (updateUrl) {
      const url = new URL(window.location.href);
      url.searchParams.set('q', trimmed);
      window.history.replaceState({}, '', url);
    }

    try {
      const response = await fetch(`/api/search?q=${encodeURIComponent(trimmed)}`);
      if (!response.ok) throw new Error('Search failed');
      const data = await response.json();
      const count = data.results?.length || 0;
      const mode = data.mode === 'semantic' ? 'semantic' : 'keyword';

      status.textContent = count
        ? `${count} ${mode} result${count === 1 ? '' : 's'} for “${data.query}”${data.message ? ` — ${data.message}` : ''}`
        : `No results found for “${data.query}”.`;

      renderResults(data.results || []);
    } catch (error) {
      status.textContent = 'Search is unavailable right now. Please try again soon.';
      resultsEl.innerHTML = '';
    }
  };

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    runSearch(input.value);
  });

  if (initialQuery) {
    runSearch(initialQuery, false);
  } else {
    status.textContent = 'Enter a search term to search the journal.';
  }
</script>

<style>
  .search-page {
    padding: calc(var(--header-height) + var(--space-lg)) 0 var(--space-xl);
  }

  .search-page__header {
    margin-bottom: var(--space-md);
    text-align: center;
  }

  .search-page__header h1 {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: var(--space-sm);
  }

  .search-page__header p {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .search-form {
    display: grid;
    gap: var(--space-sm);
    grid-template-columns: 1fr auto;
    margin-bottom: var(--space-sm);
  }

  .search-form input {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font: inherit;
    min-width: 0;
    padding: 0.9rem 1.1rem;
  }

  .search-form button {
    background: var(--color-primary);
    border-radius: 999px;
    color: var(--color-text-light);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    padding: 0.9rem 1.2rem;
    text-transform: uppercase;
    transition: background-color var(--transition-fast), opacity var(--transition-fast);
  }

  .search-form button:hover {
    background: var(--color-primary-dark);
  }

  .search-status {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    margin-bottom: var(--space-md);
    text-align: center;
  }

  .search-results {
    display: grid;
    gap: var(--space-md);
  }

  .search-result {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-md);
  }

  .search-result__link {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: 120px 1fr;
    text-decoration: none;
  }

  .search-result__link:hover h2 {
    color: var(--color-primary);
  }

  .search-result__image {
    aspect-ratio: 1;
    height: 120px;
    object-fit: cover;
    width: 120px;
  }

  .search-result__body h2 {
    font-size: 1.1rem;
    letter-spacing: 0.08em;
    line-height: 1.3;
    margin-bottom: 0.35rem;
    text-transform: uppercase;
    transition: color var(--transition-fast);
  }

  .search-result__body time {
    color: var(--color-text-secondary);
    display: block;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .search-result__body p {
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .search-result__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: var(--space-sm);
  }

  .search-result__tag {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-secondary);
    font-family: var(--font-heading);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1;
    padding: 0.35rem 0.55rem;
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    .search-form,
    .search-result__link {
      grid-template-columns: 1fr;
    }

    .search-result__image {
      height: auto;
      width: 100%;
    }
  }
</style>
