---
import PageLayout from '../layouts/PageLayout.astro';
import { journalTags } from '../data/journalTags';

const tagLabels = Object.fromEntries(journalTags.map((tag) => [tag.slug, tag.label]));
const initialQuery = Astro.url.searchParams.get('q') || '';
---

<PageLayout title="Search — The Forktree Project" description="Search the Forktree Project journal." headerVariant="dark">
  <section class="search-page">
    <div class="container--narrow">
      <header class="search-page__header">
        <a class="search-page__back" href="/blog">← Back to journal</a>
        <h1>Search the Forktree Story</h1>
        <p>Search journal posts by idea, activity, species, partner, or place.</p>
      </header>

      <form class="search-form" id="journal-search-form" role="search">
        <label class="sr-only" for="journal-search-input">Search the journal</label>
        <input
          id="journal-search-input"
          name="q"
          type="search"
          value={initialQuery}
          placeholder="Try “water management”, “butterflies”, or “school visits”"
          autocomplete="off"
        />
        <button type="submit">Search</button>
      </form>

      <p class="search-status" id="journal-search-status" aria-live="polite"></p>
      <div class="search-results" id="journal-search-results"></div>
    </div>
  </section>
</PageLayout>

<script define:vars={{ initialQuery, tagLabels }}>
  const form = document.getElementById('journal-search-form');
  const input = document.getElementById('journal-search-input');
  const status = document.getElementById('journal-search-status');
  const resultsEl = document.getElementById('journal-search-results');

  const formatDate = (date) => {
    if (!date) return '';
    return new Date(date).toLocaleDateString('en-AU', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    });
  };

  const escapeHtml = (value) => String(value || '')
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#039;');

  const renderTags = (tags = []) => tags
    .slice(0, 6)
    .map((tag) => `<span class="search-result__tag">${escapeHtml(tagLabels[tag] || tag)}</span>`)
    .join('');

  const renderResults = (results) => {
    resultsEl.innerHTML = results.map((result) => {
      const hasImage = Boolean(result.image);
      const semanticBadge = result.matchType === 'semantic'
        ? '<span class="search-result__match">Semantic match</span>'
        : '';
      return `
        <article class="search-result">
          <a href="${escapeHtml(result.href)}" class="search-result__link${hasImage ? '' : ' search-result__link--no-image'}">
            ${hasImage
              ? `<img src="${escapeHtml(result.image)}" alt="" loading="lazy" class="search-result__image" />`
              : '<div class="search-result__placeholder" aria-hidden="true">Journal</div>'}
            <div class="search-result__body">
              <h2>${escapeHtml(result.title)}</h2>
              <div class="search-result__meta">
                ${result.date ? `<time datetime="${escapeHtml(result.date)}">${escapeHtml(formatDate(result.date))}</time>` : ''}
                ${semanticBadge}
              </div>
              <p class="search-result__snippet">${escapeHtml(result.snippet || result.excerpt || '')}</p>
              ${result.tags?.length ? `<div class="search-result__tags">${renderTags(result.tags)}</div>` : ''}
            </div>
          </a>
        </article>
      `;
    }).join('');
  };

  const runSearch = async (query, updateUrl = true) => {
    const trimmed = query.trim();
    if (!trimmed) {
      status.textContent = 'Enter a search term to search the journal.';
      resultsEl.innerHTML = '';
      return;
    }

    status.textContent = 'Searching journal…';
    resultsEl.innerHTML = '';

    if (updateUrl) {
      const url = new URL(window.location.href);
      url.searchParams.set('q', trimmed);
      window.history.replaceState({}, '', url);
    }

    try {
      const response = await fetch(`/api/search?q=${encodeURIComponent(trimmed)}`);
      if (!response.ok) throw new Error('Search failed');
      const data = await response.json();
      const count = data.results?.length || 0;

      status.textContent = count
        ? `${count} result${count === 1 ? '' : 's'} for “${data.query}”`
        : `No results found for “${data.query}”.`;

      renderResults(data.results || []);
    } catch (error) {
      status.textContent = 'Search is unavailable right now. Please try again soon.';
      resultsEl.innerHTML = '';
    }
  };

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    runSearch(input.value);
  });

  if (initialQuery) {
    runSearch(initialQuery, false);
  } else {
    status.textContent = 'Enter a search term to search the journal.';
  }
</script>

<style is:global>
  .search-page {
    padding: calc(var(--header-height) + var(--space-lg)) 0 var(--space-xl);
  }

  .search-page__header {
    margin-bottom: var(--space-md);
    text-align: center;
  }

  .search-page__back {
    color: var(--color-primary);
    display: inline-flex;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-sm);
    text-decoration: none;
    text-transform: uppercase;
  }

  .search-page__back:hover {
    color: var(--color-primary-dark);
  }

  .search-page__header h1 {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: var(--space-sm);
  }

  .search-page__header p {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .search-form {
    display: grid;
    gap: var(--space-sm);
    grid-template-columns: 1fr auto;
    margin-bottom: var(--space-sm);
  }

  .search-form input {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font: inherit;
    min-width: 0;
    padding: 0.9rem 1.1rem;
  }

  .search-form button {
    background: var(--color-primary);
    border-radius: 999px;
    color: var(--color-text-light);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    padding: 0.9rem 1.2rem;
    text-transform: uppercase;
    transition: background-color var(--transition-fast), opacity var(--transition-fast);
  }

  .search-form button:hover {
    background: var(--color-primary-dark);
  }

  .search-status {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    margin-bottom: var(--space-md);
    text-align: center;
  }

  .search-results {
    display: grid;
    gap: var(--space-sm);
  }

  .search-result {
    background: #fafaf9;
    border: 1px solid var(--color-border);
    border-radius: 18px;
    padding: 0.9rem;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
  }

  .search-result:hover {
    border-color: rgba(58, 125, 50, 0.35);
    box-shadow: 0 12px 30px rgba(31, 42, 31, 0.08);
    transform: translateY(-1px);
  }

  .search-result__link {
    align-items: start;
    display: grid;
    gap: 1.1rem;
    grid-template-columns: 160px minmax(0, 1fr);
    text-decoration: none;
  }

  .search-result__link:hover h2 {
    color: var(--color-primary);
  }

  .search-result__image,
  .search-result__placeholder {
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    height: 120px;
    width: 160px;
  }

  .search-result__image {
    object-fit: cover;
  }

  .search-result__placeholder {
    align-items: center;
    background: #e8ece5;
    color: var(--color-text-secondary);
    display: flex;
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 700;
    justify-content: center;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .search-result__body h2 {
    font-size: clamp(1rem, 2vw, 1.25rem);
    letter-spacing: 0.04em;
    line-height: 1.25;
    margin-bottom: 0.35rem;
    text-transform: uppercase;
    transition: color var(--transition-fast);
  }

  .search-result__meta {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.55rem;
  }

  .search-result__body time,
  .search-result__match {
    color: var(--color-text-secondary);
    display: inline-flex;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .search-result__match {
    align-items: center;
    background: rgba(58, 125, 50, 0.1);
    border: 1px solid rgba(58, 125, 50, 0.2);
    border-radius: 999px;
    color: var(--color-primary);
    font-size: 0.58rem;
    font-weight: 700;
    line-height: 1;
    padding: 0.28rem 0.48rem;
  }

  .search-result__snippet {
    color: var(--color-text-secondary);
    display: -webkit-box;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .search-result__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.85rem;
  }

  .search-result__tag {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-secondary);
    font-family: var(--font-heading);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    padding: 0.35rem 0.55rem;
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    .search-form,
    .search-result__link {
      grid-template-columns: 1fr;
    }

    .search-result__image,
    .search-result__placeholder {
      height: auto;
      width: 100%;
    }
  }
</style>
