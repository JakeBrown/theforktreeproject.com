---
import PageLayout from '../layouts/PageLayout.astro';
import { upcomingEvents } from '../data/events';

const siteBase = Astro.site?.toString().replace(/\/$/, '') || 'https://www.theforktreeproject.com';
const eventJsonLd = upcomingEvents.map((event) => ({
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.title,
  url: event.url,
  startDate: event.date === 'Friday 5 June 2026'
    ? '2026-06-05T10:00:00+09:30'
    : event.date === 'Saturday 18 July 2026'
      ? '2026-07-18T10:00:00+09:30'
      : '2026-08-01T10:00:00+09:30',
  endDate: event.date === 'Friday 5 June 2026'
    ? '2026-06-05T15:00:00+09:30'
    : event.date === 'Saturday 18 July 2026'
      ? '2026-07-18T15:00:00+09:30'
      : '2026-08-01T15:00:00+09:30',
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  description: event.description,
  location: {
    '@type': 'Place',
    name: 'The Forktree Project',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '103 Whitelaw Road',
      addressLocality: 'Carrickalinga',
      addressRegion: 'SA',
      addressCountry: 'AU',
    },
  },
  organizer: {
    '@type': 'Organization',
    name: 'The Forktree Project',
    url: siteBase,
  },
}));
---

<PageLayout
  title="Upcoming Events — The Forktree Project"
  description="Upcoming Forktree Project planting days and community events on the Fleurieu Peninsula."
  headerVariant="dark"
>
  <section class="events-page">
    <div class="events-page__inner">
      <p class="events-kicker">Upcoming Events</p>
      <h1>Come planting with us.</h1>
      <p class="events-lead">Join us for a rewarding day of rewilding on the Fleurieu Peninsula and help restore biodiverse habitat in this beautiful coastal landscape.</p>

      <div class="events-list" aria-label="Upcoming Forktree events">
        {upcomingEvents.map((event) => (
          <article class="event-card">
            <div class="event-card__date">
              <span>{event.date}</span>
              <strong>{event.time}</strong>
            </div>
            <div class="event-card__body">
              <h2>{event.title}</h2>
              <p class="event-card__location">{event.location}</p>
              <p>{event.description}</p>
              <a href={event.url} target="_blank" rel="noopener noreferrer" class="event-card__link">
                Register via {event.source} &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>

      <div class="events-footer">
        <p>For general volunteering questions, email <a href="mailto:hello@theforktreeproject.com?subject=Forktree%20Events%20Enquiry">hello@theforktreeproject.com</a>.</p>
        <a href="/get-involved" class="events-back">More ways to get involved</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(eventJsonLd)} />
</PageLayout>

<style>
  .events-page {
    padding-top: var(--header-height);
    background: #fafaf9;
  }

  .events-page__inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 70px 60px 90px;
  }

  .events-kicker {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 3px;
    text-transform: uppercase;
    text-align: center;
    color: var(--color-text-secondary);
    margin: 0 0 1rem;
  }

  .events-page h1 {
    font-family: var(--font-heading);
    font-size: clamp(2.6rem, 6vw, 4.8rem);
    font-weight: 700;
    line-height: 1.08;
    text-align: center;
    margin: 0 0 1.5rem;
  }

  .events-lead {
    max-width: 760px;
    margin: 0 auto 3rem;
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.7;
    text-align: center;
    color: #444;
  }

  .events-list {
    display: grid;
    gap: 1.25rem;
  }

  .event-card {
    display: grid;
    grid-template-columns: minmax(210px, 0.35fr) 1fr;
    gap: 2rem;
    padding: 2rem;
    background: white;
    border: 1px solid rgba(31, 42, 31, 0.1);
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08), 0 1px 3px rgba(0, 0, 0, 0.06);
  }

  .event-card__date {
    padding-top: 0.2rem;
    color: #1f2a1f;
  }

  .event-card__date span,
  .event-card__date strong {
    display: block;
    font-family: var(--font-heading);
  }

  .event-card__date span {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.25;
    margin-bottom: 0.5rem;
  }

  .event-card__date strong {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary-dark);
  }

  .event-card h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    line-height: 1.2;
    margin: 0 0 0.75rem;
  }

  .event-card p {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    color: #444;
    margin: 0 0 1rem;
  }

  .event-card__location {
    font-weight: 600;
    color: #1f2a1f !important;
  }

  .event-card__link {
    display: inline-block;
    margin-top: 0.25rem;
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 5px;
    color: #1f2a1f;
  }

  .event-card__link:hover {
    opacity: 0.7;
  }

  .events-footer {
    max-width: 760px;
    margin: 3rem auto 0;
    text-align: center;
  }

  .events-footer p {
    color: #444;
    margin-bottom: 1.5rem;
  }

  .events-footer a:not(.events-back) {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .events-back {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #1a1a1a;
    border: 2px solid #1a1a1a;
    padding: 1rem 2rem;
    transition: all var(--transition-normal);
  }

  .events-back:hover {
    background: #1a1a1a;
    color: white;
  }

  @media (max-width: 760px) {
    .events-page__inner {
      padding: 50px 30px 70px;
    }

    .event-card {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 1.5rem;
    }
  }
</style>
