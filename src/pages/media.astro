---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="Media — The Forktree Project"
  description="Films and coverage documenting our work restoring habitat and biodiversity across the Hills & Fleurieu region and beyond."
  headerVariant="dark"
>
  <section class="media-page">
    <div class="media-page__inner">
      <header class="media-page__header">
        <p class="media-page__kicker">Media</p>
        <h1>Stories from Forktree.</h1>
        <p class="media-page__lead">
          Films and coverage documenting our work restoring habitat and biodiversity across the Hills &amp; Fleurieu region and beyond.
        </p>
      </header>

      <article class="media-feature">
        <div class="media-feature__video">
          <iframe
            src="https://www.youtube-nocookie.com/embed/9pwh01JuuyU"
            title="We’re Recreating a Lost Ecosystem — Planet Wild"
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>

        <div class="media-feature__content">
          <p class="media-feature__meta">Planet Wild · Mission 40</p>
          <h2>We’re Recreating a Lost Ecosystem</h2>
          <p>
            Planet Wild visited The Forktree Project to document how native plants, cultural knowledge and hands-on restoration are helping rebuild a landscape on South Australia’s Fleurieu Peninsula.
          </p>
          <div class="media-feature__links">
            <a href="/blog/partnering-with-planet-wild-for-a-wilder-planet">Read about the partnership&nbsp;&rarr;</a>
            <a href="https://planetwild.com/missions/40-bringing-back-australias-lost-ecosystem" target="_blank" rel="noopener noreferrer">Explore the mission on Planet Wild&nbsp;&rarr;</a>
          </div>
        </div>
      </article>
    </div>
  </section>
</PageLayout>

<style>
  .media-page {
    min-height: 80vh;
    padding-top: var(--header-height);
    background: #fafaf9;
  }

  .media-page__inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 70px 60px 100px;
  }

  .media-page__header {
    max-width: 800px;
    margin: 0 auto 3.5rem;
    text-align: center;
  }

  .media-page__kicker,
  .media-feature__meta {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary-dark);
  }

  .media-page__kicker {
    margin: 0 0 1rem;
  }

  .media-page h1 {
    font-family: var(--font-heading);
    font-size: clamp(2.6rem, 6vw, 4.8rem);
    font-weight: 700;
    line-height: 1.08;
    margin: 0 0 1.5rem;
  }

  .media-page__lead {
    max-width: 720px;
    margin: 0 auto;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.7;
    color: #444;
  }

  .media-feature {
    overflow: hidden;
    background: white;
    border: 1px solid rgba(31, 42, 31, 0.1);
    border-radius: 8px;
    box-shadow: 0 3px 16px rgba(0, 0, 0, 0.08);
  }

  .media-feature__video {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #111;
  }

  .media-feature__video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .media-feature__content {
    padding: clamp(1.75rem, 4vw, 3rem);
  }

  .media-feature__meta {
    margin: 0 0 0.75rem;
  }

  .media-feature h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.15;
    margin: 0 0 1rem;
  }

  .media-feature__content > p:not(.media-feature__meta) {
    max-width: 760px;
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.75;
    color: #444;
  }

  .media-feature__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: 1.75rem;
  }

  .media-feature__links a {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 5px;
    color: #1f2a1f;
  }

  .media-feature__links a:hover {
    opacity: 0.65;
  }

  @media (max-width: 640px) {
    .media-page__inner {
      padding: 50px 24px 70px;
    }

    .media-page__header {
      margin-bottom: 2.5rem;
    }

    .media-feature__content {
      padding: 1.5rem;
    }

    .media-feature__links {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
