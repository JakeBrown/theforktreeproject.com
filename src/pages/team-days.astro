---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="Team Days — The Forktree Project" description="Bring your team to The Forktree Project for a hands-on day of habitat restoration, learning and team building in a stunning natural setting.">

  <!-- Hero / Intro -->
  <section class="td-section td-section--hero" style="background-image: url('/images/team-days/0r9a8970-hires-8192-x-5464.jpg'); background-color: #2a3a2a;">
    <div class="td-section__content td-section__content--center">
      <div class="td-text td-text--wide">
        <h1>Team Days at The Forktree Project</h1>

        <div class="td-body">
          <p>A genuine act of environmental stewardship. A memorable team-building experience.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Detail -->
  <section class="td-section td-section--plain td-section--intro">
    <p class="td-kicker">Team Days</p>
    <div class="td-intro">
      <p class="td-intro__lead">Making a hands-on contribution to habitat restoration is not only powerful for the planet &mdash; it&rsquo;s also beneficial for individuals and teams.</p>
      <p class="td-intro__body">We warmly welcome corporate and community groups who want to take part in meaningful activities such as tree planting, seed propagation, circular-economy projects using repurposed materials, and a wide range of seasonal volunteering tasks.</p>
    </div>
  </section>

  <!-- Why -->
  <section class="td-section td-section--olive">
    <p class="td-kicker td-kicker--light">Why Forktree</p>
    <div class="td-intro">
      <p class="td-intro__lead td-intro__lead--light">Forktree Team Days offer organisations a unique blend of impact, learning, and connection.</p>
      <ul class="td-list td-list--olive">
        <li>Strengthened teamwork through shared activities that are completely different from the everyday work environment.</li>
        <li>A deep sense of achievement from contributing directly to the fight against climate change and biodiversity loss.</li>
        <li>Wellbeing benefits that come from spending a day immersed in nature.</li>
        <li>Rich learning opportunities about biodiversity, ecology, revegetation, and sustainable decision-making from the Forktree Project team.</li>
      </ul>
      <div class="td-photos">
        <div class="td-photo">
          <img src="/images/team-days/img_4504.jpg" alt="Team group photo at The Forktree Project" loading="lazy" />
        </div>
        <div class="td-photo">
          <img src="/images/team-days/img_4457.jpg" alt="Hands-on team day activities at The Forktree Project" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- What a day looks like -->
  <section class="td-section td-section--plain">
    <div class="td-section__content td-section__content--center">
      <div class="td-text td-text--wide">
        <h2>What a Team Day Looks Like</h2>

        <div class="td-body">
          <p>Every Team Day is tailored to the needs and interests of the visiting group, as well as seasonal conditions.</p>

          <div class="td-cta">
            <a href="/team-days/schedule" class="btn--cta btn--cta-lg td-cta--dark">See a Sample Schedule &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</PageLayout>

<style>
  .td-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-size: cover;
    background-position: center;
    background-attachment: scroll;
    color: var(--color-text-light);
    overflow: hidden;
  }

  .td-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 50% at 50% 45%, rgba(0, 0, 0, 0.35) 0%, transparent 100%),
      rgba(0, 0, 0, 0.3);
    z-index: 1;
  }

  .td-section--plain {
    background: #fafaf9;
    color: #1a1a1a;
    min-height: auto;
    padding: 0;
  }

  .td-section--plain::before {
    display: none;
  }

  .td-section--plain .td-section__content {
    padding: 0 100px;
  }

  .td-section--plain .td-text {
    text-shadow: none;
    max-width: 800px;
  }

  .td-section--plain .td-text h2 {
    color: #1a1a1a;
  }

  .td-section--plain .td-body p {
    opacity: 1;
    color: #333;
  }

  .td-section--plain .td-list li {
    opacity: 1;
    color: #333;
  }

  .td-section--plain .td-list li::before {
    color: #00A651;
  }

  .td-kicker {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: 3px;
    text-transform: uppercase;
    text-align: center;
    color: var(--color-text);
    margin: 0;
    padding: 80px 60px 0;
  }

  .td-intro {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px 60px;
  }

  .td-intro__lead {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    font-weight: 700;
    line-height: 1.35;
    color: #1a1a1a;
    margin-bottom: 1.25rem;
  }

  .td-section--olive {
    background: #1f2a1f;
    color: rgba(255, 255, 255, 0.85);
    min-height: auto;
    padding: 0;
  }

  .td-section--olive::before {
    display: none;
  }

  .td-kicker--light {
    color: rgba(255, 255, 255, 0.55);
  }

  .td-intro__lead--light {
    color: #fff;
  }

  .td-list--olive {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    text-align: left;
    max-width: 800px;
  }

  .td-list--olive li {
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 0.75rem;
    padding-left: 1.5rem;
    position: relative;
  }

  .td-list--olive li::before {
    content: '\2022';
    position: absolute;
    left: 0;
    color: rgba(255, 255, 255, 0.4);
  }

  .td-photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-lg) 0 0;
  }

  .td-photo {
    line-height: 0;
  }

  .td-photo img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    border-radius: 12px;
  }

  @media (max-width: 768px) {
    .td-photos {
      grid-template-columns: 1fr;
    }
  }

  .td-intro__body {
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    line-height: 1.7;
    color: #444;
    margin-bottom: 0;
  }

  .td-section__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1600px;
    padding: 180px 100px;
  }

  .td-section__content--center {
    display: flex;
    justify-content: center;
  }

  .td-text {
    max-width: 50%;
    position: relative;
    padding: 1rem 1.5rem;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.7), 0 0 30px rgba(0, 0, 0, 0.4);
  }

  .td-text--wide {
    max-width: 65%;
    text-align: center;
  }

  .td-text h1 {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.1;
    margin-bottom: var(--space-lg);
  }

  .td-text h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: var(--space-lg);
  }

  .td-body p {
    font-family: var(--font-body);
    font-size: clamp(1.15rem, 1.8vw, 1.3rem);
    line-height: 1.7;
    letter-spacing: 0.02em;
    margin-bottom: 1rem;
    opacity: 0.9;
  }

  .td-body a {
    color: white;
    text-decoration: underline;
  }

  .td-body a:hover {
    opacity: 0.7;
  }

  .td-list {
    list-style: none;
    padding: 0;
    margin: 1rem auto;
    text-align: left;
    max-width: 600px;
  }

  .td-list li {
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.5vw, 1.15rem);
    line-height: 1.7;
    margin-bottom: 0.75rem;
    padding-left: 1.5rem;
    position: relative;
    opacity: 0.9;
  }

  .td-list li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: white;
  }

  .td-list--schedule li::before {
    content: '';
  }

  .td-list--schedule li {
    padding-left: 0;
  }

  .td-cta {
    margin-top: var(--space-md);
  }

  .btn--cta {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: white;
    border: 2px solid white;
    padding: 13px 26px;
    text-decoration: none;
    transition: all var(--transition-normal);
  }

  .btn--cta:hover {
    background-color: white;
    color: #000;
  }

  .td-cta--dark {
    color: #1a1a1a;
    border-color: #1a1a1a;
  }

  .td-cta--dark:hover {
    background-color: #1a1a1a;
    color: white;
  }

  .btn--cta-lg {
    font-size: 14px;
    padding: 18px 40px;
    letter-spacing: 1.5px;
  }

  @media (max-width: 768px) {
    .td-section {
      background-attachment: scroll;
      min-height: auto;
    }

    .td-section__content {
      padding: 100px 30px;
    }

    .td-text,
    .td-text--wide {
      max-width: 100%;
    }
  }
</style>
