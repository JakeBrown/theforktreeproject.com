  'img_4696.jpg',                     // 14. House with log/deck in front
  'img_4690.jpg',                     // 15. House with garden and vertical posts
  // Unplaced keepers at end:
  'photo-30-3-2026-15-17-11.jpg',    // Sitting area wider angle
  'photo-30-3-2026-15-37-27.jpg',    // Moody wine shot
