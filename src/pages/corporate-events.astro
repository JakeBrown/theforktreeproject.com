---
import PageLayout from '../layouts/PageLayout.astro';
import { Image, getImage } from 'astro:assets';

export const prerender = true;

import img2 from '../assets/images/corporate-events/2.jpg';
import img5 from '../assets/images/corporate-events/5.jpg';
import img9 from '../assets/images/corporate-events/9.jpg';
import img12 from '../assets/images/corporate-events/12.jpg';
import img14 from '../assets/images/corporate-events/14.jpg';
import img17 from '../assets/images/corporate-events/17.jpg';
import img18 from '../assets/images/corporate-events/18.jpg';
import img20 from '../assets/images/corporate-events/20.jpg';
import img22 from '../assets/images/corporate-events/22.jpg';
import img23 from '../assets/images/corporate-events/23.jpg';
import img26 from '../assets/images/corporate-events/26.jpg';
import img31 from '../assets/images/corporate-events/31.jpg';
import img33 from '../assets/images/corporate-events/33.jpg';
import img36 from '../assets/images/corporate-events/36.jpg';

const mainImage = img23;  // Kitchen with glasses across to sitting area

const photos = [
  img18,   // Kitchen front on
  img36,   // Lecture room
  img2,    // Small break out room
  img20,   // From above
  img22,   // Kitchen with glasses
  img17,   // Arty floral display
  img14,   // Close up of sitting area
  img26,   // Arty floral display and wine bottle
  img12,   // Deck
  img33,   // Bench and view
  img31,   // Fire pit
  img9,    // View of house from distance
  img5,    // View of house from across garden
];

const heroBg = await getImage({ src: img5, width: 1920, format: 'webp' });
const testimonialBg = await getImage({ src: img5, width: 1920, format: 'webp' });
---

<PageLayout title="Corporate Events Venue — The Forktree Project" description="Host your next corporate event, off-siter or team-building day at The Forktree Project's restored shearing shed with modern amenities, rustic charm and panoramic ocean views.">

  <!-- Hero -->
  <section class="ce-hero" style={`background-image: url('${heroBg.src}'); background-color: #2a3a2a;`}>
    <div class="ce-hero__content">
      <h1>Corporate events at The Forktree Project</h1>
      <p class="ce-hero__tagline"><span class="ce-hero__tagline-text">Rustic charm. Modern amenities. Stunning views. Perfect for inspiration and innovation.</span></p>
    </div>
    <div class="ce-hero__scroll">
      <svg width="20" height="12" viewBox="0 0 20 12" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M1 1L10 10L19 1" stroke="white" stroke-width="2"/>
      </svg>
    </div>
  </section>

  <!-- Intro -->
  <section class="ce-section ce-section--intro ce-section--plain">
    <div class="ce-intro">
      <div class="ce-intro__text">
        <p class="ce-intro__lead">Host your next corporate event, off-siter, strategy session or team-building day at The Forktree Project.</p>
        <p class="ce-intro__body">Our beautifully restored shearing shed blends modern amenities with rustic charm, all set against panoramic ocean views, creating the perfect space to plan, connect, and recharge your team.</p>
        <p class="ce-intro__body">Run on renewable energy, our fully off-grid venue is ideal for organisations looking to reduce their impact on the planet while enjoying a unique and inspiring setting. Conveniently located just one hour from the Adelaide CBD&mdash;against the flow of traffic!</p>
      </div>
      <div class="ce-intro__image">
        <Image src={img14} alt="The Forktree Project sitting area" width={800} loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Facilities -->
  <section class="ce-section ce-section--facilities ce-section--plain ce-section--alt">
    <div class="ce-section__content ce-section__content--left">
      <div class="ce-text">
        <h2>Facilities</h2>
        <div class="ce-facilities-columns">
          <ul class="ce-list">
            <li><span class="ce-list__icon" aria-hidden="true">&#10003;</span> Wifi throughout</li>
            <li><span class="ce-list__icon" aria-hidden="true">&#10003;</span> Main lecture room for up to 30 people with AV facilities</li>
            <li><span class="ce-list__icon" aria-hidden="true">&#10003;</span> 4 break-out rooms for smaller groups</li>
            <li><span class="ce-list__icon" aria-hidden="true">&#10003;</span> BBQ and pizza oven</li>
            <li><span class="ce-list__icon" aria-hidden="true">&#10003;</span> A range of experiential activities involving nursery work or tree planting available upon request</li>
          </ul>
          <ul class="ce-list">
            <li><span class="ce-list__icon" aria-hidden="true">&#10003;</span> Open plan kitchen and common room for onsite catering with tea and coffee-making facilities, microwave, fridge and oven</li>
            <li><span class="ce-list__icon" aria-hidden="true">&#10003;</span> Covered verandah with sea views to take time out or run sessions outside</li>
            <li><span class="ce-list__icon" aria-hidden="true">&#10003;</span> 3 wheelchair-accessible toilets/bathrooms</li>
            <li><span class="ce-list__icon" aria-hidden="true">&#10003;</span> Wheelchair access throughout</li>
            <li><span class="ce-list__icon" aria-hidden="true">&#10003;</span> Ample on-site parking</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Photo Gallery -->
  <section class="ce-gallery">
    <div class="ce-gallery__inner">
      <h2>Our Venue</h2>
      <div class="ce-gallery__featured">
        <a href={mainImage.src} class="ce-gallery__hero-img" data-lightbox="0">
          <Image src={mainImage} alt="The Forktree Project venue" width={1400} loading="lazy" />
        </a>
      </div>
      <div class="ce-gallery__grid" id="gallery-grid">
        {photos.map((photo, i) => (
          <a href={photo.src} class={`ce-gallery__item${i === photos.length - 1 && photos.length % 2 !== 0 ? ' ce-gallery__item--last-odd' : ''}`} data-lightbox={i + 1}>
            <Image src={photo} alt="The Forktree Project venue" width={500} loading="lazy" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <script>
    // Testimonial expand/collapse
    document.querySelectorAll('.ce-testimonial-card__toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const target = document.getElementById(btn.dataset.target);
        if (target) {
          const expanded = target.classList.toggle('ce-testimonial-card__full--visible');
          btn.textContent = expanded ? 'Show less' : 'Read full testimonial';
        }
      });
    });

    // Lightbox
    (() => {
      const lightbox = document.getElementById('lightbox');
      const backdrop = document.getElementById('lightbox-backdrop');
      const closeBtn = document.getElementById('lightbox-close');
      const prevBtn = document.getElementById('lightbox-prev');
      const nextBtn = document.getElementById('lightbox-next');
      const stage = document.getElementById('lightbox-stage');
      const img = document.getElementById('lightbox-img');
      const counter = document.getElementById('lightbox-counter');

      // Collect all photo URLs from gallery links
      const links = Array.from(document.querySelectorAll('[data-lightbox]'));
      const photoUrls = links.map(a => a.getAttribute('href'));
      let current = 0;
      let touchStartX = 0;
      let touchStartY = 0;
      let touchDeltaX = 0;
      let swiping = false;

      function preload(index) {
        if (index >= 0 && index < photoUrls.length) {
          const i = new Image();
          i.src = photoUrls[index];
        }
      }

      function show(index) {
        current = index;
        img.classList.remove('ce-lightbox__img--loaded');
        img.src = photoUrls[current];
        counter.textContent = `${current + 1} / ${photoUrls.length}`;
        prevBtn.style.display = current === 0 ? 'none' : '';
        nextBtn.style.display = current === photoUrls.length - 1 ? 'none' : '';
        // Preload neighbours
        preload(current - 1);
        preload(current + 1);
      }

      function open(index) {
        show(index);
        lightbox.classList.add('ce-lightbox--open');
        lightbox.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        img.addEventListener('load', onImgLoad, { once: true });
      }

      function close() {
        lightbox.classList.remove('ce-lightbox--open');
        lightbox.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        img.src = '';
      }

      function onImgLoad() {
        img.classList.add('ce-lightbox__img--loaded');
      }

      img.addEventListener('load', onImgLoad);

      // Click handlers on gallery items
      links.forEach((link) => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const idx = parseInt(link.dataset.lightbox, 10);
          open(idx);
        });
      });

      // Navigation
      prevBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (current > 0) show(current - 1);
      });
      nextBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (current < photoUrls.length - 1) show(current + 1);
      });

      // Close
      closeBtn.addEventListener('click', close);
      backdrop.addEventListener('click', close);

      // Keyboard
      document.addEventListener('keydown', (e) => {
        if (!lightbox.classList.contains('ce-lightbox--open')) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft' && current > 0) show(current - 1);
        if (e.key === 'ArrowRight' && current < photoUrls.length - 1) show(current + 1);
      });

      // Touch swipe
      stage.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        touchDeltaX = 0;
        swiping = false;
      }, { passive: true });

      stage.addEventListener('touchmove', (e) => {
        touchDeltaX = e.touches[0].clientX - touchStartX;
        const deltaY = Math.abs(e.touches[0].clientY - touchStartY);
        // Only swipe if horizontal movement dominates
        if (Math.abs(touchDeltaX) > 15 && Math.abs(touchDeltaX) > deltaY) {
          swiping = true;
          img.style.transform = `translateX(${touchDeltaX}px)`;
          img.style.transition = 'none';
        }
      }, { passive: true });

      stage.addEventListener('touchend', () => {
        if (!swiping) return;
        img.style.transition = 'transform 0.3s ease';
        const threshold = 60;
        if (touchDeltaX < -threshold && current < photoUrls.length - 1) {
          img.style.transform = 'translateX(-100vw)';
          setTimeout(() => {
            img.style.transition = 'none';
            img.style.transform = 'translateX(100vw)';
            show(current + 1);
            requestAnimationFrame(() => {
              img.style.transition = 'transform 0.3s ease';
              img.style.transform = 'translateX(0)';
            });
          }, 250);
        } else if (touchDeltaX > threshold && current > 0) {
          img.style.transform = 'translateX(100vw)';
          setTimeout(() => {
            img.style.transition = 'none';
            img.style.transform = 'translateX(-100vw)';
            show(current - 1);
            requestAnimationFrame(() => {
              img.style.transition = 'transform 0.3s ease';
              img.style.transform = 'translateX(0)';
            });
          }, 250);
        } else {
          img.style.transform = 'translateX(0)';
        }
        swiping = false;
      }, { passive: true });
    })();
  </script>

  <!-- Testimonials -->
  <section class="ce-section ce-section--testimonials" style={`background-image: url('${testimonialBg.src}'); background-color: #1a2a1a;`}>
    <div class="ce-section__content ce-section__content--center">
      <div class="ce-testimonials">
        <h2>What People Are Saying</h2>
        <div class="ce-testimonials__grid">

          <blockquote class="ce-testimonial-card">
            <div class="ce-testimonial-card__quote" aria-hidden="true">&ldquo;</div>
            <div class="ce-testimonial-card__body">
              <p class="ce-testimonial-card__pullquote">The Forktree Project is a compelling alternative to a traditional corporate function centre.</p>
              <div class="ce-testimonial-card__full" id="testimonial-pew">
                <p>We recently hosted a corporate event for 30 people at the Forktree Project and it exceeded our expectations in every respect. The thoughtfully renovated farmhouse, featuring an expansive deck with stunning ocean views, has been beautifully crafted using recycled and environmentally sustainable materials. The meeting room offers an excellent setting for focused, productive work, while the generous breakout spaces provide a seamless and spacious connection with the surrounding natural landscape. With its breathtaking outlook and purpose-designed spaces, <span class="ce-testimonial-card__highlight">the Forktree Project is a compelling alternative to a traditional corporate function centre.</span></p>
              </div>
              <button class="ce-testimonial-card__toggle" data-target="testimonial-pew" type="button">Read full testimonial</button>
            </div>
            <div class="ce-testimonial-card__divider"></div>
            <cite class="ce-testimonial-card__cite">Pew Charitable Trusts</cite>
          </blockquote>

          <blockquote class="ce-testimonial-card">
            <div class="ce-testimonial-card__quote" aria-hidden="true">&ldquo;</div>
            <div class="ce-testimonial-card__body">
              <p class="ce-testimonial-card__pullquote">The experience reinforced the importance of grounding environmental leadership in real-world systems and care for land beyond the office or boardroom.</p>
              <div class="ce-testimonial-card__full" id="testimonial-epa">
                <p>The Environment Protection Authority thanks the Forktree Project team for providing a meaningful setting for our senior leadership group at Forktree. The day offered a valuable opportunity to step outside our usual environment and reconnect with the land in a way that was practical, reflective and genuinely meaningful.</p>
                <p>Through expertly guided, hands-on nursery activities, time spent working with the soil, and shared conversations in a natural setting, leaders were encouraged to slow down, observe the impact of the season on the land, and engage with environmental stewardship at a human scale. The structure of the day supported thoughtful discussion while allowing space for connection and reflection.</p>
                <p><span class="ce-testimonial-card__highlight">The experience reinforced the importance of grounding environmental leadership in real-world systems and care for land beyond the office or boardroom.</span> It provided a shared reference point for reflection, learning and collective purpose.</p>
                <p>We extend our thanks to Tim, Liz, Fleur, and the Forktree team for the care, expertise and generosity they brought to the day. The team&rsquo;s thoughtful guidance and strong connection to place created an experience that will stay with our leaders well beyond the visit.</p>
              </div>
              <button class="ce-testimonial-card__toggle" data-target="testimonial-epa" type="button">Read full testimonial</button>
            </div>
            <div class="ce-testimonial-card__divider"></div>
            <cite class="ce-testimonial-card__cite">The Environment Protection Authority SA</cite>
          </blockquote>

        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="ce-section ce-section--cta ce-section--plain">
    <div class="ce-section__content ce-section__content--center">
      <div class="ce-cta">
        <h2>Get in Touch</h2>
        <p>Email us at <a href="mailto:hello@theforktreeproject.com">hello@theforktreeproject.com</a> for details.</p>
      </div>
    </div>
  </section>

  <!-- Lightbox -->
  <div class="ce-lightbox" id="lightbox" aria-hidden="true" role="dialog" aria-label="Photo viewer">
    <div class="ce-lightbox__backdrop" id="lightbox-backdrop"></div>
    <button class="ce-lightbox__close" id="lightbox-close" type="button" aria-label="Close">&times;</button>
    <div class="ce-lightbox__counter" id="lightbox-counter"></div>
    <button class="ce-lightbox__nav ce-lightbox__nav--prev" id="lightbox-prev" type="button" aria-label="Previous photo">
      <svg width="24" height="44" viewBox="0 0 24 44" fill="none"><path d="M22 2L2 22L22 42" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <button class="ce-lightbox__nav ce-lightbox__nav--next" id="lightbox-next" type="button" aria-label="Next photo">
      <svg width="24" height="44" viewBox="0 0 24 44" fill="none"><path d="M2 2L22 22L2 42" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <div class="ce-lightbox__stage" id="lightbox-stage">
      <img class="ce-lightbox__img" id="lightbox-img" src="" alt="The Forktree Project venue" />
    </div>
  </div>

</PageLayout>

<style>
  html {
    scroll-behavior: smooth;
  }

  /* Hero */
  .ce-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    color: var(--color-text-light);
    overflow: hidden;
  }

  .ce-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 50% at 50% 45%, rgba(0, 0, 0, 0.35) 0%, transparent 100%),
      rgba(0, 0, 0, 0.35);
    z-index: 1;
  }

  .ce-hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 800px;
    padding: 0 30px;
  }

  .ce-hero__content h1 {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-bottom: 0.75rem;
  }

  .ce-hero__tagline {
    font-family: var(--font-body);
    font-size: clamp(1.15rem, 1.8vw, 1.3rem);
    font-weight: 400;
    line-height: 1.7;
    letter-spacing: 0.02em;
  }

  .ce-hero__tagline-text {
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.7), 0 0 30px rgba(0, 0, 0, 0.4);
  }

  .ce-hero__scroll {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    opacity: 0.7;
    animation: bounceDown 2s ease-in-out infinite;
  }

  @keyframes bounceDown {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(8px); }
  }

  /* Sections */
  .ce-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    color: var(--color-text-light);
    overflow: hidden;
  }

  .ce-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 1;
  }

  .ce-section--plain {
    background: #fafaf9;
    color: #1a1a1a;
    min-height: auto;
  }

  .ce-section--plain::before {
    display: none;
  }

  .ce-section--alt {
    background: #f0efed;
  }

  /* Intro split layout */
  .ce-intro {
    display: flex;
    align-items: center;
    gap: 3rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px 60px;
  }

  .ce-intro__text {
    flex: 1;
  }

  .ce-intro__lead {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    font-weight: 700;
    line-height: 1.35;
    color: #1a1a1a;
    margin-bottom: 1.25rem;
  }

  .ce-intro__body {
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    line-height: 1.7;
    color: #444;
    margin-bottom: 1rem;
  }

  .ce-intro__body:last-child {
    margin-bottom: 0;
  }

  .ce-intro__image {
    flex: 0 0 40%;
    border-radius: 8px;
    overflow: hidden;
  }

  .ce-intro__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 3 / 4;
    border-radius: 8px;
  }

  .ce-section--plain .ce-text,
  .ce-section--plain .ce-text--wide {
    background: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    box-shadow: none;
    max-width: 800px;
  }

  .ce-section--plain .ce-list__icon {
    color: #00A651;
  }

  .ce-section--plain .ce-text h2 {
    color: #1a1a1a;
  }

  .ce-section--plain .ce-text p,
  .ce-section--plain .ce-list li {
    opacity: 1;
    color: #333;
  }

  .ce-section__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1600px;
    padding: 180px 100px;
  }

  .ce-section__content--center {
    display: flex;
    justify-content: center;
  }

  .ce-section__content--left {
    display: flex;
    justify-content: flex-start;
  }

  .ce-text {
    max-width: 50%;
    position: relative;
    padding: 1.5rem 2rem;
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-radius: 8px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
  }

  .ce-text--wide {
    max-width: 750px;
    text-align: center;
  }

  .ce-text h2 {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    margin-bottom: var(--space-lg);
  }

  .ce-text p {
    font-family: var(--font-body);
    font-size: clamp(0.85rem, 1.3vw, 1rem);
    line-height: 1.7;
    margin-bottom: 1rem;
    opacity: 0.9;
  }

  .ce-text p:last-child {
    margin-bottom: 0;
  }

  .ce-text__location {
    font-style: italic;
    font-weight: 600;
    margin-top: 1rem;
  }

  /* Facilities columns */
  .ce-facilities-columns {
    display: flex;
    gap: 2rem;
    margin-top: 0.5rem;
  }

  .ce-facilities-columns .ce-list {
    flex: 1;
  }

  /* Facilities list */
  .ce-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .ce-list li {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 0;
    font-size: clamp(0.85rem, 1.3vw, 1rem);
    line-height: 1.6;
    opacity: 0.9;
  }

  .ce-list__icon {
    color: #22c55e;
    font-weight: 700;
    font-size: 0.95em;
    flex-shrink: 0;
    width: 1em;
    text-align: center;
  }

  /* Gallery */
  .ce-gallery {
    background: #111;
    color: var(--color-text-light);
    padding: 100px 60px;
  }

  .ce-gallery__inner {
    max-width: 1400px;
    margin: 0 auto;
  }

  .ce-gallery__inner h2 {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .ce-gallery__featured {
    margin-bottom: 12px;
  }

  .ce-gallery__hero-img {
    display: block;
    overflow: hidden;
    border-radius: 6px;
    aspect-ratio: 21 / 9;
    width: 100%;
  }

  .ce-gallery__hero-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .ce-gallery__hero-img:hover img {
    transform: scale(1.03);
  }

  .ce-gallery__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 12px;
  }

  .ce-gallery__item {
    display: block;
    overflow: hidden;
    border-radius: 4px;
    aspect-ratio: 4 / 3;
  }

  .ce-gallery__item--last-odd {
    grid-column: span 2;
    aspect-ratio: 21 / 9;
  }

  .ce-gallery__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .ce-gallery__item:hover img {
    transform: scale(1.05);
  }



  /* Testimonials */
  .ce-testimonials {
    max-width: 900px;
