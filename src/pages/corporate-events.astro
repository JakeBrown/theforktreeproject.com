const photos = [
  'photo-30-3-2026-15-36-56.jpg',   // 1. Kitchen towards sitting area with glasses
  'img_4688.jpg',                     // 2. Lecture room
  'img_4657.jpg',                     // 3. Small break out room
  'photo-30-3-2026-15-22-01.jpg',    // 4. Kitchen front on
  'photo-30-3-2026-15-35-39.jpg',    // 5. Kitchen with glasses and wine
  'photo-30-3-2026-15-26-35.jpg',    // 6. View of space from above / arty vase silhouette
  'photo-30-3-2026-15-19-34.jpg',    // 7. Arty floral display
  'photo-30-3-2026-15-37-18.jpg',    // 8. Arty wine on benchtop shot
  'img_4593.jpg',                     // 9. Close up of sitting area
  'img_4774.jpg',                     // 10. Deck (NEW photo)
