---
import AdminDetailGroups from '../../../components/AdminDetailGroups.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { addManualVisit, adelaideTimeInputValue, deleteVisit, editVisitTimes } from '../../../lib/attendanceEdits';
import { formatDate, formatDateTime, formatTime } from '../../../lib/admin';
import {
  REGISTRATION_COLUMNS,
  mediaConsentLabel,
  registrationDetailGroups,
  wwccLabel,
  type VolunteerRegistration,
} from '../../../lib/registrationDetails';
import {
  SIGN_IN_DECLARATION_VERSION,
  formatExpectedTime,
  getAdelaideDate,
} from '../../../lib/volunteerAttendance';
import {
  VOLUNTEER_PROFILE_COLUMNS,
  getVolunteerDatabase,
  refreshVolunteerRecords,
  type VolunteerProfile,
} from '../../../lib/volunteerDb';
import {
  MAX_PHOTO_BYTES,
  PROFILE_DETAIL_FIELDS,
  PROFILE_EMERGENCY_FIELDS,
  PROFILE_FIELDS,
  PROFILE_NOTE_FIELDS,
  parsePositiveId,
  parseProfileForm,
  parseVisitForm,
  type ProfileFieldDefinition,
} from '../../../lib/volunteerProfiles';

export const prerender = false;

interface AttendanceRow {
  sign_in_id: number;
  volunteer_date: string;
  signed_in_at: string;
  signed_out_at: string | null;
  sign_out_method: string | null;
  declaration_version: string | null;
  last_edit_action: string | null;
  last_edited_by: string | null;
  last_edited_at: string | null;
  was_added: number;
}

interface VisitRow {
  id: number;
  visit_date: string;
  start_time: string;
  end_time: string;
  notes: string;
}

const id = parsePositiveId(Astro.params.id);
const database = getVolunteerDatabase(Astro.locals);
if (!id) return new Response('Not found', { status: 404 });

const today = getAdelaideDate();
let formErrors: Record<string, string> = {};
let submittedValues: Record<string, string> | null = null;
let visitError = '';
let attendanceError = '';
// Which dialog to reopen with the error, and what the admin typed, so nothing has to be re-entered.
let attendanceErrorDialog = '';
let attendanceValues: Record<string, string> = {};
const editedBy = String((Astro.locals as any).adminActor || 'admin');
let visitValues = { visit_date: '', start_time: '', end_time: '', visit_notes: '' };

if (Astro.request.method === 'POST' && database) {
  const form = await Astro.request.formData();
  const action = form.get('action');

  if (action === 'save-profile') {
    const parsed = parseProfileForm(form);
    if (!parsed.success) {
      formErrors = parsed.errors;
      submittedValues = parsed.values;
    } else {
      const values = parsed.values;
      const clash = values.phone_normalized
        ? await database
            .prepare('SELECT id, full_name FROM volunteers WHERE phone_normalized = ?1 AND id <> ?2 LIMIT 1')
            .bind(values.phone_normalized, id)
            .first<{ id: number; full_name: string }>()
        : null;
      if (clash) {
        formErrors = { phone: `This phone number is already on ${clash.full_name}’s profile (#${clash.id}).` };
        submittedValues = values;
      } else {
        const columns = PROFILE_FIELDS.map((field) => field.name);
        const assignments = [...columns, 'phone_normalized'].map((column, index) => `${column} = ?${index + 1}`);
        await database
          .prepare(
            `UPDATE volunteers SET ${assignments.join(', ')}, updated_at = ?${columns.length + 2}
             WHERE id = ?${columns.length + 3}`
          )
          .bind(...columns.map((column) => values[column]), values.phone_normalized, new Date().toISOString(), id)
          .run();
        return Astro.redirect(`/admin/volunteers/${id}?notice=saved`, 303);
      }
    }
  } else if (action === 'add-visit') {
    const parsed = parseVisitForm(form, today);
    visitValues = {
      visit_date: String(form.get('visit_date') || ''),
      start_time: String(form.get('start_time') || ''),
      end_time: String(form.get('end_time') || ''),
      visit_notes: String(form.get('visit_notes') || '').slice(0, 300),
    };
    if (!parsed.success) {
      visitError = parsed.error;
    } else {
      await database
        .prepare(
          `INSERT INTO volunteer_scheduled_visits (volunteer_id, visit_date, start_time, end_time, notes, created_at)
           VALUES (?1, ?2, ?3, ?4, ?5, ?6)`
        )
        .bind(id, parsed.values.visit_date, parsed.values.start_time, parsed.values.end_time, parsed.values.notes, new Date().toISOString())
        .run();
      return Astro.redirect(`/admin/volunteers/${id}?notice=visit-added#visits`, 303);
    }
  } else if (action === 'add-attendance' || action === 'edit-attendance' || action === 'delete-attendance') {
    const times = { signIn: String(form.get('sign_in') || ''), signOut: String(form.get('sign_out') || '') };
    const signInId = parsePositiveId(form.get('sign_in_id'));
    attendanceValues = { date: String(form.get('date') || ''), sign_in: times.signIn, sign_out: times.signOut };
    let result: { ok: true } | { ok: false; error: string } = { ok: false, error: 'That visit could not be found.' };
    if (action === 'add-attendance') {
      const profile = await database
        .prepare('SELECT id, full_name, phone, phone_normalized FROM volunteers WHERE id = ?1')
        .bind(id)
        .first<{ id: number; full_name: string; phone: string; phone_normalized: string }>();
      if (profile) {
        result = await addManualVisit(database, { volunteer: profile, date: String(form.get('date') || ''), times, editedBy, today });
      }
    } else if (signInId && action === 'edit-attendance') {
      result = await editVisitTimes(database, {
        signInId,
        volunteerId: id,
        times,
        expected: { signedInAt: String(form.get('expected_sign_in') || ''), signedOutAt: String(form.get('expected_sign_out') || '') },
        editedBy,
        today,
      });
    } else if (signInId) {
      result = await deleteVisit(database, { signInId, volunteerId: id, editedBy });
    }
    if (result.ok) {
      const notice = action === 'add-attendance' ? 'attendance-added' : action === 'edit-attendance' ? 'attendance-saved' : 'attendance-deleted';
      return Astro.redirect(`/admin/volunteers/${id}?notice=${notice}#history`, 303);
    }
    attendanceError = result.error;
    attendanceErrorDialog = action === 'add-attendance' ? 'attendance-add' : signInId ? `attendance-edit-${signInId}` : '';
  } else if (action === 'delete-visit') {
    const visitId = parsePositiveId(form.get('visit_id'));
    if (visitId) {
      await database
        .prepare('DELETE FROM volunteer_scheduled_visits WHERE id = ?1 AND volunteer_id = ?2')
        .bind(visitId, id)
        .run();
    }
    return Astro.redirect(`/admin/volunteers/${id}?notice=visit-removed#visits`, 303);
  }
}

let volunteer: VolunteerProfile | null = null;
let attendance: AttendanceRow[] = [];
let visits: VisitRow[] = [];
let registrations: VolunteerRegistration[] = [];
let photoUpdated = '';
let loadError = false;

if (!database) {
  loadError = true;
} else {
  try {
    await refreshVolunteerRecords(database);
    volunteer = await database
      .prepare(`SELECT ${VOLUNTEER_PROFILE_COLUMNS} FROM volunteers v WHERE v.id = ?1`)
      .bind(id)
      .first<VolunteerProfile>();
    if (volunteer) {
      const [attendanceResult, visitResult, photo] = await Promise.all([
        database
          .prepare(
            `SELECT s.id AS sign_in_id, s.volunteer_date, s.signed_in_at, a.signed_out_at, a.sign_out_method, a.declaration_version,
               e.action AS last_edit_action, e.edited_by AS last_edited_by, e.edited_at AS last_edited_at,
               EXISTS (SELECT 1 FROM volunteer_attendance_edits e3 WHERE e3.sign_in_id = s.id AND e3.action = 'add') AS was_added
             FROM volunteer_attendance a JOIN volunteer_sign_ins s ON s.id = a.sign_in_id
             LEFT JOIN volunteer_attendance_edits e ON e.id = (
               SELECT MAX(e2.id) FROM volunteer_attendance_edits e2 WHERE e2.sign_in_id = s.id
             )
             WHERE a.volunteer_id = ?1
             ORDER BY s.volunteer_date DESC, s.signed_in_at DESC
             LIMIT 500`
          )
          .bind(id)
          .all<AttendanceRow>(),
        database
          .prepare(
            `SELECT id, visit_date, start_time, end_time, notes FROM volunteer_scheduled_visits
             WHERE volunteer_id = ?1 AND visit_date >= ?2
             ORDER BY visit_date ASC, start_time ASC LIMIT 200`
          )
          .bind(id, today)
          .all<VisitRow>(),
        database
          .prepare('SELECT updated_at FROM volunteer_photos WHERE volunteer_id = ?1')
          .bind(id)
          .first<{ updated_at: string }>(),
      ]);
      attendance = attendanceResult.results || [];
      visits = visitResult.results || [];
      photoUpdated = photo?.updated_at || '';
      if (volunteer.registration_id) {
        // The linked (newest) form plus any earlier forms submitted with the same phone number.
        const registrationResult = await database
          .prepare(
            `SELECT ${REGISTRATION_COLUMNS} FROM volunteer_registrations
             WHERE id = ?1 OR (phone_normalized <> '' AND phone_normalized = (SELECT phone_normalized FROM volunteer_registrations WHERE id = ?1))
             ORDER BY registered_at DESC, id DESC LIMIT 20`
          )
          .bind(volunteer.registration_id)
          .all<VolunteerRegistration>();
        registrations = registrationResult.results || [];
      }
    }
  } catch (error) {
    loadError = true;
    console.error('Unable to load volunteer profile', error);
  }
}

if (!loadError && !volunteer) return new Response('Volunteer not found', { status: 404 });

const values: Record<string, string> = submittedValues
  || Object.fromEntries(PROFILE_FIELDS.map((field) => [field.name, String((volunteer as any)?.[field.name] ?? '')]));

const maxPhotoMegabytes = (MAX_PHOTO_BYTES * 1e-6).toFixed(1);
const NOTICES: Record<string, { text: string; error?: boolean }> = {
  saved: { text: 'Profile saved.' },
  created: { text: 'Volunteer added. Fill in their details below.' },
  exists: { text: 'A volunteer with that phone number already exists, so their profile is shown instead.' },
  'visit-added': { text: 'Visit scheduled.' },
  'visit-removed': { text: 'Scheduled visit removed.' },
  'photo-saved': { text: 'Photo saved.' },
  'attendance-added': { text: 'Visit added to the attendance history.' },
  'attendance-saved': { text: 'Visit times updated.' },
  'attendance-deleted': { text: 'Visit deleted.' },
  'photo-removed': { text: 'Photo removed.' },
  'photo-missing': { text: 'Choose a photo to upload.', error: true },
  'photo-too-large': { text: `That photo is too large. Use an image under ${maxPhotoMegabytes} MB.`, error: true },
  'photo-invalid': { text: 'That file is not a JPEG, PNG or WebP image.', error: true },
};
const notice = NOTICES[Astro.url.searchParams.get('notice') || ''];
const todayRecord = attendance.find((row) => row.volunteer_date === today);
const confirmedCount = attendance.filter((row) => row.sign_out_method === 'confirmed').length;
const automaticCount = attendance.filter((row) => row.sign_out_method === 'automatic').length;
const [registration, ...earlierRegistrations] = registrations;
const initials = (volunteer?.full_name || '?').split(/\s+/).filter(Boolean).slice(0, 2).map((part) => part[0]?.toUpperCase()).join('');

function inputType(field: ProfileFieldDefinition) {
  return field.type || 'text';
}
---

<AdminLayout title={volunteer?.full_name || 'Volunteer'} description="Volunteer profile." active="volunteers">
  {loadError || !volunteer ? (
    <section class="admin-state" role="alert">
      <h2>This profile could not be loaded</h2>
      <p>Refresh the page or try again later.</p>
    </section>
  ) : (
    <>
      <a class="profile-back" href="/admin/volunteers">← All volunteers</a>
      <header class="admin-page-heading profile-heading">
        <div class="profile-heading__identity">
          {photoUpdated ? (
            <img class="profile-photo" src={`/admin/volunteers/${id}/photo?v=${encodeURIComponent(photoUpdated)}`} alt={`Photo of ${volunteer.full_name}`} width="96" height="96" />
          ) : (
            <span class="profile-photo profile-photo--initials" aria-hidden="true">{initials}</span>
          )}
          <div>
            <p class="admin-kicker">Volunteer profile</p>
            <h1>{volunteer.full_name}</h1>
            <p class="admin-summary">
              {attendance.length} {attendance.length === 1 ? 'visit' : 'visits'} recorded
              {todayRecord && (
                todayRecord.signed_out_at
                  ? <span class="attendance-badge attendance-badge--signed-out">Signed out today</span>
                  : <span class="attendance-badge attendance-badge--signed-in">Signed in today</span>
              )}
              {visits[0] && <span class="attendance-badge attendance-badge--scheduled">Next visit {formatDate(visits[0].visit_date)}</span>}
            </p>
          </div>
        </div>
        {registration ? (
          <button type="button" class="admin-button profile-registration-button" data-dialog-open="registration-dialog" aria-haspopup="dialog" aria-controls="registration-dialog">
            View registration form
          </button>
        ) : (
          <p class="profile-hint profile-registration-missing">No registration form on file</p>
        )}
      </header>

      {notice && <p class:list={['admin-flash', notice.error ? 'admin-flash--error' : 'admin-flash--success']} role="status">{notice.text}</p>}

      <div class="profile-layout">
        <form class="profile-card profile-form" method="post" action={`/admin/volunteers/${id}`}>
          <input type="hidden" name="action" value="save-profile" />
          {[
            { heading: 'Details', fields: PROFILE_DETAIL_FIELDS },
            { heading: 'Emergency contacts', fields: PROFILE_EMERGENCY_FIELDS },
            { heading: 'Notes', fields: PROFILE_NOTE_FIELDS },
          ].map((group) => (
            <fieldset>
              <legend>{group.heading}</legend>
              <div class="profile-fields">
                {group.fields.map((field) => (
                  <div class:list={['admin-field', { 'profile-field--wide': field.multiline }]}>
                    <label for={`profile-${field.name}`}>{field.label}</label>
                    {field.multiline ? (
                      <textarea id={`profile-${field.name}`} name={field.name} maxlength={field.maxLength} aria-invalid={formErrors[field.name] ? 'true' : undefined}>{values[field.name]}</textarea>
                    ) : (
                      <input id={`profile-${field.name}`} name={field.name} type={inputType(field)} maxlength={field.maxLength} value={values[field.name]} autocomplete="off" aria-invalid={formErrors[field.name] ? 'true' : undefined} required={field.name === 'full_name'} />
                    )}
                    {formErrors[field.name] && <span class="profile-error">{formErrors[field.name]}</span>}
                  </div>
                ))}
              </div>
            </fieldset>
          ))}
          <div class="profile-form__footer">
            <button class="admin-button" type="submit">Save profile</button>
          </div>
        </form>

        <aside class="profile-side">
          <section class="profile-card" id="photo" aria-labelledby="photo-heading">
            <h2 id="photo-heading">Photo</h2>
            <p class="profile-hint">Optional. Photos are resized in the browser before upload and are only visible to admins.</p>
            <form method="post" action={`/admin/volunteers/${id}/photo`} enctype="multipart/form-data" class="profile-photo-form" data-photo-form>
              <div class="admin-field">
                <label for="profile-photo-input">{photoUpdated ? 'Replace photo' : 'Upload photo'}</label>
                <input id="profile-photo-input" name="photo" type="file" accept="image/jpeg,image/png,image/webp" required />
              </div>
              <input type="hidden" name="action" value="upload" />
              <button class="admin-button" type="submit">Save photo</button>
            </form>
            {photoUpdated && (
              <form method="post" action={`/admin/volunteers/${id}/photo`} enctype="multipart/form-data">
                <input type="hidden" name="action" value="remove" />
                <button class="profile-text-button" type="submit">Remove photo</button>
              </form>
            )}
          </section>

          <section class="profile-card" id="visits" aria-labelledby="visits-heading">
            <h2 id="visits-heading">Scheduled visits</h2>
            {visits.length === 0 ? (
              <p class="profile-hint">No upcoming visits scheduled.</p>
            ) : (
              <ul class="profile-visits">
                {visits.map((visit) => (
                  <li>
                    <div>
                      <strong>{formatDate(visit.visit_date)}</strong>
                      <span>{formatExpectedTime(visit.start_time, visit.end_time) || 'No time set'}</span>
                      {visit.notes && <span class="profile-visits__notes">{visit.notes}</span>}
                    </div>
                    <form method="post" action={`/admin/volunteers/${id}`}>
                      <input type="hidden" name="action" value="delete-visit" />
                      <input type="hidden" name="visit_id" value={String(visit.id)} />
                      <button class="profile-text-button" type="submit" aria-label={`Remove visit on ${formatDate(visit.visit_date)}`}>Remove</button>
                    </form>
                  </li>
                ))}
              </ul>
            )}
            <form class="profile-visit-form" method="post" action={`/admin/volunteers/${id}#visits`}>
              <input type="hidden" name="action" value="add-visit" />
              <div class="admin-field profile-field--wide">
                <label for="visit-date">Date</label>
                <input id="visit-date" name="visit_date" type="date" min={today} value={visitValues.visit_date} required />
              </div>
              <div class="admin-field">
                <label for="visit-start">Expected arrival (optional)</label>
                <input id="visit-start" name="start_time" type="time" value={visitValues.start_time} />
              </div>
              <div class="admin-field">
                <label for="visit-end">Expected finish (optional)</label>
                <input id="visit-end" name="end_time" type="time" value={visitValues.end_time} />
              </div>
              <div class="admin-field profile-field--wide">
                <label for="visit-notes">Notes (optional)</label>
                <input id="visit-notes" name="visit_notes" type="text" maxlength="300" value={visitValues.visit_notes} placeholder="e.g. Nursery potting" />
              </div>
              {visitError && <p class="profile-error profile-field--wide" role="alert">{visitError}</p>}
              <button class="admin-button profile-field--wide" type="submit">Schedule visit</button>
            </form>
          </section>
        </aside>
      </div>

      {registration && (
        <dialog class="admin-dialog" id="registration-dialog" aria-labelledby="registration-dialog-title">
          <article class="admin-dialog__panel">
            <header class="admin-dialog__header">
              <div>
                <p class="admin-dialog__eyebrow">Registration form · submitted {formatDateTime(registration.registered_at)}</p>
                <h2 id="registration-dialog-title">{registration.full_name}</h2>
              </div>
              <button class="admin-dialog__close" type="button" data-dialog-close aria-label="Close registration form">×</button>
            </header>
            <div class="admin-dialog__body">
              <ul class="registration-flags" aria-label="Key registration details">
                <li>{registration.is_under_18 ? 'Under 18' : 'Adult'}</li>
                <li>WWCC: {wwccLabel(registration.wwcc_status)}</li>
                <li>{mediaConsentLabel(registration.media_consent)}</li>
                {registration.medical_information && <li>Medical information provided</li>}
              </ul>
              <AdminDetailGroups groups={registrationDetailGroups(registration)} />
              {earlierRegistrations.map((earlier) => (
                <details class="registration-earlier">
                  <summary>Earlier registration form, submitted {formatDateTime(earlier.registered_at)}</summary>
                  <AdminDetailGroups groups={registrationDetailGroups(earlier)} />
                </details>
              ))}
            </div>
          </article>
        </dialog>
      )}

      <section class="profile-history" id="history" aria-labelledby="history-heading">
        <div class="profile-history__heading">
          <div>
            <h2 id="history-heading">Attendance history</h2>
            <p class="admin-summary">{confirmedCount} confirmed and {automaticCount} automatic sign-outs</p>
          </div>
          <button type="button" class="admin-button" data-dialog-open="attendance-add" aria-haspopup="dialog" aria-controls="attendance-add">Add a visit</button>
        </div>
        {attendanceError && !attendanceErrorDialog && <p class="admin-flash admin-flash--error" role="alert">{attendanceError}</p>}
        {attendance.length === 0 ? (
          <section class="admin-state"><h2>No attendance yet</h2><p>Sign-ins will appear here.</p></section>
        ) : (
          <div class="records-table-wrap">
            <table class="records-table">
              <caption class="sr-only">Attendance history for {volunteer.full_name}, newest first</caption>
              <thead>
                <tr>
                  <th scope="col">Date</th>
                  <th scope="col">Signed in</th>
                  <th scope="col">Signed out</th>
                  <th scope="col">Declaration</th>
                  <th scope="col"><span class="sr-only">Actions</span></th>
                </tr>
              </thead>
              <tbody>
                {attendance.map((row) => {
                  const dialogId = `attendance-edit-${row.sign_in_id}`;
                  const hasError = attendanceErrorDialog === dialogId;
                  const editedNote = row.last_edited_at
                    ? `${row.last_edit_action === 'add' ? 'Added' : 'Edited'} by ${row.last_edited_by} on ${formatDateTime(row.last_edited_at)}`
                    : '';
                  return (
                    <tr>
                      <td data-label="Date">
                        <time datetime={row.volunteer_date}>{formatDate(row.volunteer_date)}</time>
                        {editedNote && <span class="attendance-edited" title={editedNote}>{row.was_added ? 'Added by admin' : 'Edited'}</span>}
                      </td>
                      <td data-label="Signed in">{formatTime(row.signed_in_at)}</td>
                      <td data-label="Signed out">
                        {row.signed_out_at ? (
                          <span class="profile-signout">
                            {formatTime(row.signed_out_at)}
                            {row.sign_out_method === 'automatic'
                              ? <span class="attendance-badge attendance-badge--automatic" title="Not confirmed by the volunteer">Automatic</span>
                              : <span class="attendance-badge attendance-badge--signed-out">Confirmed</span>}
                          </span>
                        ) : <span class="attendance-badge attendance-badge--signed-in">Still signed in</span>}
                      </td>
                      <td data-label="Declaration">
                        {row.declaration_version
                          ? `Agreed${row.declaration_version === SIGN_IN_DECLARATION_VERSION ? '' : ` (${row.declaration_version})`}`
                          : row.was_added ? 'Not applicable' : 'Before declaration'}
                      </td>
                      <td data-label="Actions" class="record-actions">
                        <button type="button" class="record-view-button" data-dialog-open={dialogId} aria-haspopup="dialog" aria-controls={dialogId} aria-label={`Edit visit on ${formatDate(row.volunteer_date)}`}>Edit</button>
                        <dialog class="admin-dialog attendance-dialog" id={dialogId} aria-labelledby={`${dialogId}-title`} data-open-on-load={hasError ? '' : undefined}>
                          <article class="admin-dialog__panel">
                            <header class="admin-dialog__header">
                              <div>
                                <p class="admin-dialog__eyebrow">Edit visit{editedNote ? ` · ${editedNote}` : ''}</p>
                                <h2 id={`${dialogId}-title`}>{formatDate(row.volunteer_date)}</h2>
                              </div>
                              <button class="admin-dialog__close" type="button" data-dialog-close aria-label="Close">×</button>
                            </header>
                            <div class="admin-dialog__body">
                              <form class="attendance-form" method="post" action={`/admin/volunteers/${id}#history`}>
                                <input type="hidden" name="action" value="edit-attendance" />
                                <input type="hidden" name="sign_in_id" value={String(row.sign_in_id)} />
                                <input type="hidden" name="expected_sign_in" value={row.signed_in_at} />
                                <input type="hidden" name="expected_sign_out" value={row.signed_out_at || ''} />
                                {hasError && <p class="admin-flash admin-flash--error attendance-form__wide" role="alert">{attendanceError}</p>}
                                <div class="admin-field">
                                  <label for={`${dialogId}-in`}>Signed in</label>
                                  <input id={`${dialogId}-in`} name="sign_in" type="time" value={hasError ? attendanceValues.sign_in : adelaideTimeInputValue(row.signed_in_at)} required />
                                </div>
                                <div class="admin-field">
                                  <label for={`${dialogId}-out`}>Signed out</label>
                                  <input id={`${dialogId}-out`} name="sign_out" type="time" value={hasError ? attendanceValues.sign_out : adelaideTimeInputValue(row.signed_out_at)} required={row.volunteer_date < today} />
                                </div>
                                {row.sign_out_method === 'automatic' && <p class="profile-hint attendance-form__wide">This was an automatic 5pm sign-out. Saving records the time you enter instead.</p>}
                                <button class="admin-button attendance-form__wide" type="submit">Save times</button>
                              </form>
                              <form class="attendance-delete" method="post" action={`/admin/volunteers/${id}#history`} data-confirm-label="Click again to delete this visit">
                                <input type="hidden" name="action" value="delete-attendance" />
                                <input type="hidden" name="sign_in_id" value={String(row.sign_in_id)} />
                                <button class="profile-text-button" type="submit">Delete this visit</button>
                              </form>
                            </div>
                          </article>
                        </dialog>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
        <dialog class="admin-dialog attendance-dialog" id="attendance-add" aria-labelledby="attendance-add-title" data-open-on-load={attendanceErrorDialog === 'attendance-add' ? '' : undefined}>
          <article class="admin-dialog__panel">
            <header class="admin-dialog__header">
              <div>
                <p class="admin-dialog__eyebrow">Attendance history</p>
                <h2 id="attendance-add-title">Add a missed visit</h2>
              </div>
              <button class="admin-dialog__close" type="button" data-dialog-close aria-label="Close">×</button>
            </header>
            <div class="admin-dialog__body">
              <form class="attendance-form" method="post" action={`/admin/volunteers/${id}#history`}>
                <input type="hidden" name="action" value="add-attendance" />
                {attendanceErrorDialog === 'attendance-add' && <p class="admin-flash admin-flash--error attendance-form__wide" role="alert">{attendanceError}</p>}
                <div class="admin-field attendance-form__wide">
                  <label for="attendance-add-date">Date</label>
                  <input id="attendance-add-date" name="date" type="date" max={today} value={attendanceErrorDialog === 'attendance-add' ? attendanceValues.date : ''} required />
                </div>
                <div class="admin-field">
                  <label for="attendance-add-in">Signed in</label>
                  <input id="attendance-add-in" name="sign_in" type="time" value={attendanceErrorDialog === 'attendance-add' ? attendanceValues.sign_in : ''} required />
                </div>
                <div class="admin-field">
                  <label for="attendance-add-out">Signed out</label>
                  <input id="attendance-add-out" name="sign_out" type="time" value={attendanceErrorDialog === 'attendance-add' ? attendanceValues.sign_out : ''} />
                </div>
                <p class="profile-hint attendance-form__wide">Use this when someone worked but didn’t sign in. Sign-out time is required for past days.</p>
                <button class="admin-button attendance-form__wide" type="submit">Add visit</button>
              </form>
            </div>
          </article>
        </dialog>
      </section>
    </>
  )}
</AdminLayout>

<script>
  // Links to /admin/volunteers/<id>#registration (from the Volunteers list) open the form directly.
  // Wait for load so the shared dialog handlers in AdminLayout are attached first.
  window.addEventListener('load', () => {
    // Reopen an attendance dialog that came back with a validation error.
    const failed = document.querySelector<HTMLDialogElement>('dialog[data-open-on-load]');
    if (failed) document.querySelector<HTMLElement>(`[data-dialog-open="${failed.id}"]`)?.click();
    if (window.location.hash === '#registration') {
      document.querySelector<HTMLElement>('[data-dialog-open="registration-dialog"]')?.click();
    }
  });

  // Resize photos in the browser so uploads stay small (phone photos are often 3-8 MB).
  const MAX_DIMENSION = 800;
  document.querySelectorAll<HTMLFormElement>('[data-photo-form]').forEach((form) => {
    const input = form.querySelector<HTMLInputElement>('input[type="file"]');
    if (!input) return;
    input.addEventListener('change', async () => {
      const file = input.files?.[0];
      if (!file || !file.type.startsWith('image/') || typeof createImageBitmap !== 'function') return;
      try {
        const bitmap = await createImageBitmap(file);
        const scale = Math.min(1, MAX_DIMENSION / Math.max(bitmap.width, bitmap.height));
        const canvas = document.createElement('canvas');
        canvas.width = Math.round(bitmap.width * scale);
        canvas.height = Math.round(bitmap.height * scale);
        canvas.getContext('2d')?.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
        const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/jpeg', 0.85));
        if (!blob) return;
        const transfer = new DataTransfer();
        transfer.items.add(new File([blob], 'photo.jpg', { type: 'image/jpeg' }));
        input.files = transfer.files;
      } catch {
        // Keep the original file; the server enforces the size limit.
      }
    });
  });
</script>

