---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { ADMIN_RESULT_LIMIT, escapeLike, formatDate } from '../../../lib/admin';
import { getAdelaideDate } from '../../../lib/volunteerAttendance';
import { getVolunteerDatabase, refreshVolunteerRecords } from '../../../lib/volunteerDb';
import { normalizePhone } from '../../../lib/volunteerSignIn';

export const prerender = false;

interface VolunteerRow {
  id: number;
  full_name: string;
  preferred_name: string;
  phone: string;
  emergency_contact_name: string;
  emergency_contact_phone: string;
  visit_count: number;
  last_date: string | null;
  next_visit: string | null;
  photo_updated: string | null;
}

const database = getVolunteerDatabase(Astro.locals);
const name = (Astro.url.searchParams.get('name') || '').trim().replace(/\s+/g, ' ').slice(0, 100);
const today = getAdelaideDate();
let createError = '';
let createValues = { full_name: '', phone: '' };

if (Astro.request.method === 'POST' && database) {
  const form = await Astro.request.formData();
  createValues = {
    full_name: String(form.get('full_name') || '').trim().replace(/\s+/g, ' ').slice(0, 120),
    phone: String(form.get('phone') || '').trim().replace(/\s+/g, ' ').slice(0, 30),
  };
  const phoneNormalized = createValues.phone ? normalizePhone(createValues.phone) : '';

  if (createValues.full_name.length < 2) {
    createError = 'Enter the volunteer’s full name.';
  } else if (createValues.phone && (phoneNormalized.length < 8 || phoneNormalized.length > 15)) {
    createError = 'Enter a valid phone number, or leave it blank.';
  } else {
    try {
      await refreshVolunteerRecords(database);
      const existing = phoneNormalized
        ? await database
            .prepare('SELECT id FROM volunteers WHERE phone_normalized = ?1 LIMIT 1')
            .bind(phoneNormalized)
            .first<{ id: number }>()
        : null;
      if (existing) {
        return Astro.redirect(`/admin/volunteers/${existing.id}?notice=exists`, 303);
      }
      const now = new Date().toISOString();
      const created = await database
        .prepare(
          `INSERT INTO volunteers (full_name, phone, phone_normalized, created_at, updated_at)
           VALUES (?1, ?2, ?3, ?4, ?4) RETURNING id`
        )
        .bind(createValues.full_name, createValues.phone, phoneNormalized, now)
        .first<{ id: number }>();
      if (created) return Astro.redirect(`/admin/volunteers/${created.id}?notice=created`, 303);
      createError = 'The volunteer could not be added. Please try again.';
    } catch (error) {
      console.error('Unable to create volunteer profile', error);
      createError = 'The volunteer could not be added. Please try again.';
    }
  }
}

let volunteers: VolunteerRow[] = [];
let loadError = false;

if (!database) {
  loadError = true;
} else {
  try {
    await refreshVolunteerRecords(database);
    const where = name ? "WHERE (v.full_name LIKE ?2 ESCAPE '\\' COLLATE NOCASE OR v.preferred_name LIKE ?2 ESCAPE '\\' COLLATE NOCASE)" : '';
    const statement = database.prepare(
      `SELECT v.id, v.full_name, v.preferred_name, v.phone, v.emergency_contact_name, v.emergency_contact_phone,
        (SELECT COUNT(*) FROM volunteer_attendance a WHERE a.volunteer_id = v.id) AS visit_count,
        (SELECT MAX(s.volunteer_date) FROM volunteer_sign_ins s JOIN volunteer_attendance a ON a.sign_in_id = s.id WHERE a.volunteer_id = v.id) AS last_date,
        (SELECT MIN(sv.visit_date) FROM volunteer_scheduled_visits sv WHERE sv.volunteer_id = v.id AND sv.visit_date >= ?1) AS next_visit,
        (SELECT p.updated_at FROM volunteer_photos p WHERE p.volunteer_id = v.id) AS photo_updated
       FROM volunteers v
       ${where}
       ORDER BY v.full_name COLLATE NOCASE ASC, v.id ASC
       LIMIT ${ADMIN_RESULT_LIMIT}`
    );
    const result = await (name ? statement.bind(today, `%${escapeLike(name)}%`) : statement.bind(today)).all<VolunteerRow>();
    volunteers = result.results || [];
  } catch (error) {
    loadError = true;
    console.error('Unable to load volunteer profiles', error);
  }
}

const initials = (value: string) =>
  value.split(/\s+/).filter(Boolean).slice(0, 2).map((part) => part[0]?.toUpperCase()).join('') || '?';
---

<AdminLayout title="Volunteers" description="Volunteer profiles for The Forktree Project." active="volunteers">
  <header class="admin-page-heading">
    <div>
      <p class="admin-kicker">Volunteer records</p>
      <h1>Volunteers</h1>
      <p class="admin-summary">
        {loadError ? 'Volunteer profiles are unavailable.' : `${volunteers.length} ${volunteers.length === 1 ? 'profile' : 'profiles'}${name ? ' matching' : ''}. Profiles are created automatically from sign-ins and registrations.`}
      </p>
    </div>
  </header>

  <div class="volunteer-tools">
    <form class="admin-filters volunteer-search" method="get" action="/admin/volunteers" role="search">
      <div class="admin-field">
        <label for="volunteer-search-name">Volunteer name</label>
        <input id="volunteer-search-name" name="name" type="search" value={name} maxlength="100" placeholder="Search name" />
      </div>
      <button class="admin-button" type="submit">Search</button>
      {name && <a class="admin-link-button" href="/admin/volunteers">Clear</a>}
    </form>

    <form class="admin-filters volunteer-create" method="post" action="/admin/volunteers">
      <div class="admin-field">
        <label for="new-volunteer-name">New volunteer name</label>
        <input id="new-volunteer-name" name="full_name" type="text" maxlength="120" value={createValues.full_name} required autocomplete="off" />
      </div>
      <div class="admin-field">
        <label for="new-volunteer-phone">Phone (optional)</label>
        <input id="new-volunteer-phone" name="phone" type="tel" maxlength="30" value={createValues.phone} autocomplete="off" />
      </div>
      <button class="admin-button" type="submit">Add volunteer</button>
    </form>
  </div>
  {createError && <p class="admin-flash admin-flash--error" role="alert">{createError}</p>}

  {loadError ? (
    <section class="admin-state" role="alert">
      <h2>Volunteers could not be loaded</h2>
      <p>Refresh the page or try again later.</p>
    </section>
  ) : volunteers.length === 0 ? (
    <section class="admin-state">
      <h2>{name ? 'No matching volunteers' : 'No volunteer profiles yet'}</h2>
      <p>{name ? 'Try a different name.' : 'Profiles appear when volunteers sign in or register.'}</p>
    </section>
  ) : (
    <div class="records-table-wrap">
      <table class="records-table volunteers-table">
        <caption class="sr-only">Volunteer profiles, sorted by name</caption>
        <thead>
          <tr>
            <th scope="col">Volunteer</th>
            <th scope="col">Phone</th>
            <th scope="col">Emergency contact</th>
            <th scope="col">Visits</th>
            <th scope="col">Last attended</th>
            <th scope="col">Next scheduled</th>
          </tr>
        </thead>
        <tbody>
          {volunteers.map((volunteer) => (
            <tr>
              <td data-label="Volunteer">
                <a class="volunteer-name-link" href={`/admin/volunteers/${volunteer.id}`}>
                  {volunteer.photo_updated ? (
                    <img class="volunteer-avatar" src={`/admin/volunteers/${volunteer.id}/photo?v=${encodeURIComponent(volunteer.photo_updated)}`} alt="" width="40" height="40" loading="lazy" />
                  ) : (
                    <span class="volunteer-avatar volunteer-avatar--initials" aria-hidden="true">{initials(volunteer.full_name)}</span>
                  )}
                  <span>
                    <strong>{volunteer.full_name}</strong>
                    {volunteer.preferred_name && volunteer.preferred_name !== volunteer.full_name && (
                      <span class="volunteer-preferred">“{volunteer.preferred_name}”</span>
                    )}
                  </span>
                </a>
              </td>
              <td data-label="Phone" class="record-contact">{volunteer.phone || 'Not provided'}</td>
              <td data-label="Emergency contact">
                {volunteer.emergency_contact_name || volunteer.emergency_contact_phone
                  ? `${volunteer.emergency_contact_name}${volunteer.emergency_contact_phone ? ` · ${volunteer.emergency_contact_phone}` : ''}`
                  : <span class="volunteer-missing">Missing</span>}
              </td>
              <td data-label="Visits">{Number(volunteer.visit_count)}</td>
              <td data-label="Last attended">{volunteer.last_date ? formatDate(volunteer.last_date) : '—'}</td>
              <td data-label="Next scheduled">
                {volunteer.next_visit ? <span class="attendance-badge attendance-badge--scheduled">{formatDate(volunteer.next_visit)}</span> : '—'}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</AdminLayout>

<style is:global>
  .volunteer-tools { display: grid; grid-template-columns: 1fr 1.3fr; gap: 1rem; }
  .volunteer-search { grid-template-columns: minmax(10rem, 1fr) auto auto; }
  .volunteer-create { grid-template-columns: minmax(10rem, 1fr) minmax(8rem, 0.8fr) auto; }
  .volunteer-name-link { display: inline-flex; align-items: center; gap: 0.75rem; color: #1f2a1f; }
  .volunteer-name-link:hover strong { color: #285f25; text-decoration: underline; }
  .volunteer-name-link:focus-visible { outline: 3px solid rgba(58, 125, 50, 0.25); outline-offset: 2px; }
  .volunteer-avatar { flex: 0 0 auto; width: 40px; height: 40px; border-radius: 50%; object-fit: cover; background: #e7efe3; }
  .volunteer-avatar--initials { display: inline-grid; place-items: center; color: #3d6b38; font-size: 0.75rem; font-weight: 700; }
  .volunteer-preferred { display: block; color: #657063; font-size: 0.78rem; }
  .volunteer-missing { color: #8c5a12; font-size: 0.8rem; font-weight: 600; }

  @media (max-width: 1000px) {
    .volunteer-tools { grid-template-columns: 1fr; gap: 0; }
  }
  @media (max-width: 520px) {
    .volunteer-search, .volunteer-create { grid-template-columns: 1fr; }
  }
</style>
