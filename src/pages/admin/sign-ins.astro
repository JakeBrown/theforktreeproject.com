---
import AdminRecordDialog from '../../components/AdminRecordDialog.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import '../../styles/admin-calendar.css';
import {
  ADMIN_RESULT_LIMIT,
  displayValue,
  escapeLike,
  formatDate,
  formatDateTime,
  formatTime,
  yesNo,
  type D1Database,
  type DetailGroup,
} from '../../lib/admin';
import {
  calendarWeeks,
  formatMonth,
  getSignInAdminParams,
  isDemoSignInName,
  monthBounds,
  shiftMonth,
} from '../../lib/adminSignIns';
import { getVolunteerDatabase, refreshVolunteerRecords } from '../../lib/volunteerDb';

export const prerender = false;

interface VolunteerSignIn {
  id: number;
  full_name: string;
  email: string;
  phone: string;
  volunteer_date: string;
  communications_consent: number;
  signed_in_at: string;
  signed_out_at: string | null;
  sign_out_method: string | null;
  declaration_version: string | null;
  volunteer_id: number | null;
}

interface SignInCount {
  volunteer_date: string;
  sign_in_count: number;
}

const params = getSignInAdminParams(Astro.url.searchParams);
const monthLabel = formatMonth(params.month);
const weeks = calendarWeeks(params.month);
const [monthStart, nextMonthStart] = monthBounds(params.month);
const previousMonth = params.month === '2000-01' ? null : shiftMonth(params.month, -1);
const nextMonth = params.month === '2100-12' ? null : shiftMonth(params.month, 1);
let signIns: VolunteerSignIn[] = [];
let counts: SignInCount[] = [];
let listIsLimited = false;
let loadError = false;
const database = getVolunteerDatabase(Astro.locals) as unknown as D1Database | undefined;

if (!database) {
  loadError = true;
} else {
  try {
    await refreshVolunteerRecords(getVolunteerDatabase(Astro.locals)!);
    if (params.view === 'calendar') {
      const [countResult, signInResult] = await Promise.all([
        database
          .prepare(
            `SELECT volunteer_date, COUNT(*) AS sign_in_count
             FROM volunteer_sign_ins
             WHERE volunteer_date >= ? AND volunteer_date < ?
             GROUP BY volunteer_date
             ORDER BY volunteer_date ASC
             LIMIT ?`
          )
          .bind(monthStart, nextMonthStart, 31)
          .all<SignInCount>(),
        database
          .prepare(
            `SELECT s.id, s.full_name, s.email, s.phone, s.volunteer_date, s.communications_consent, s.signed_in_at,
              a.signed_out_at, a.sign_out_method, a.declaration_version, a.volunteer_id
             FROM volunteer_sign_ins s
             LEFT JOIN volunteer_attendance a ON a.sign_in_id = s.id
             WHERE s.volunteer_date >= ? AND s.volunteer_date < ?
             ORDER BY s.signed_in_at DESC, s.id DESC
             LIMIT ?`
          )
          .bind(monthStart, nextMonthStart, ADMIN_RESULT_LIMIT)
          .all<VolunteerSignIn>(),
      ]);
      counts = countResult.results || [];
      signIns = signInResult.results || [];
    } else {
      const where = params.name ? "WHERE s.full_name LIKE ? ESCAPE '\\' COLLATE NOCASE" : '';
      let statement = database.prepare(
        `SELECT s.id, s.full_name, s.email, s.phone, s.volunteer_date, s.communications_consent, s.signed_in_at,
          a.signed_out_at, a.sign_out_method, a.declaration_version, a.volunteer_id
         FROM volunteer_sign_ins s
         LEFT JOIN volunteer_attendance a ON a.sign_in_id = s.id
         ${where}
         ORDER BY s.signed_in_at DESC, s.id DESC
         LIMIT ?`
      );
      statement = params.name
        ? statement.bind(`%${escapeLike(params.name)}%`, ADMIN_RESULT_LIMIT + 1)
        : statement.bind(ADMIN_RESULT_LIMIT + 1);
      const result = await statement.all<VolunteerSignIn>();
      const rows = result.results || [];
      listIsLimited = rows.length > ADMIN_RESULT_LIMIT;
      signIns = rows.slice(0, ADMIN_RESULT_LIMIT);
    }
  } catch {
    loadError = true;
    console.error('Unable to load volunteer sign-ins');
  }
}

const countByDate = new Map(counts.map((row) => [row.volunteer_date, Number(row.sign_in_count)]));
const recordsByDate = new Map<string, VolunteerSignIn[]>();
for (const signIn of signIns) {
  const records = recordsByDate.get(signIn.volunteer_date) || [];
  records.push(signIn);
  recordsByDate.set(signIn.volunteer_date, records);
}
const calendarTotal = counts.reduce((total, row) => total + Number(row.sign_in_count), 0);
const calendarIsLimited = calendarTotal > signIns.length;
const listLabel = listIsLimited
  ? `Showing the newest ${ADMIN_RESULT_LIMIT}${params.name ? ' matching' : ''} records; more are available`
  : `${signIns.length} ${signIns.length === 1 ? 'record' : 'records'}, newest first`;

function signOutLabel(signIn: VolunteerSignIn, full = false): string {
  if (!signIn.signed_out_at) return 'Still signed in';
  const time = full ? formatDateTime(signIn.signed_out_at) : formatTime(signIn.signed_out_at);
  return `${time} · ${signIn.sign_out_method === 'automatic' ? 'Automatic (not confirmed)' : 'Confirmed by volunteer'}`;
}

function detailsFor(signIn: VolunteerSignIn): DetailGroup[] {
  return [
    {
      heading: 'Sign-in details',
      items: [
        { label: 'Record ID', value: String(signIn.id) },
        { label: 'Volunteer date', value: formatDate(signIn.volunteer_date) },
        { label: 'Signed in', value: formatDateTime(signIn.signed_in_at) },
        { label: 'Signed out', value: signOutLabel(signIn, true) },
        { label: 'Declaration', value: signIn.declaration_version ? `Agreed (version ${signIn.declaration_version})` : 'Not recorded (signed in before the declaration was added)' },
      ],
    },
    {
      heading: 'Volunteer',
      items: [
        { label: 'Full name', value: displayValue(signIn.full_name) },
        { label: 'Phone', value: displayValue(signIn.phone) },
        { label: 'Email (legacy records)', value: displayValue(signIn.email) },
        { label: 'Communications consent (legacy records)', value: yesNo(signIn.communications_consent) },
      ],
    },
  ];
}
---

<AdminLayout
  title="Volunteer sign-ins"
  description="Review volunteer sign-ins for The Forktree Project."
  active="sign-ins"
>
  <header class="admin-page-heading sign-ins-heading">
    <div>
      <p class="admin-kicker">Volunteer records</p>
      <h1>Sign-ins</h1>
      <p class="admin-summary">
        {loadError ? 'Sign-ins are unavailable.' : params.view === 'calendar'
          ? `${calendarTotal} ${calendarTotal === 1 ? 'sign-in' : 'sign-ins'} across ${counts.length} ${counts.length === 1 ? 'day' : 'days'} in ${monthLabel}`
          : listLabel}
      </p>
    </div>
    <nav class="view-switch" aria-label="Sign-in view">
      <a href={`/admin/sign-ins?month=${params.month}`} aria-current={params.view === 'calendar' ? 'page' : undefined}>Calendar</a>
      <a href="/admin/sign-ins?view=list" aria-current={params.view === 'list' ? 'page' : undefined}>List</a>
    </nav>
  </header>

  {params.view === 'list' && (
    <form class="admin-filters sign-in-search" method="get" action="/admin/sign-ins" role="search">
      <input type="hidden" name="view" value="list" />
      <div class="admin-field">
        <label for="sign-in-name">Volunteer name</label>
        <input id="sign-in-name" name="name" type="search" value={params.name} maxlength="100" placeholder="Search full name" />
      </div>
      <button class="admin-button" type="submit">Search</button>
      {params.name && <a class="admin-link-button" href="/admin/sign-ins?view=list">Clear search</a>}
    </form>
  )}

  {loadError ? (
    <section class="admin-state" role="alert">
      <h2>Sign-ins could not be loaded</h2>
      <p>Refresh the page or try again later.</p>
    </section>
  ) : params.view === 'calendar' ? (
    <section class="sign-in-calendar" aria-labelledby="calendar-month">
      <header class="calendar-toolbar">
        {previousMonth ? (
          <a class="calendar-nav" href={`/admin/sign-ins?month=${previousMonth}`} aria-label={`View ${formatMonth(previousMonth)}`}>
            <span aria-hidden="true">←</span><span>Previous</span>
          </a>
        ) : (
          <span class="calendar-nav calendar-nav--disabled" aria-disabled="true"><span aria-hidden="true">←</span><span>Previous</span></span>
        )}
        <h2 id="calendar-month">{monthLabel}</h2>
        {nextMonth ? (
          <a class="calendar-nav" href={`/admin/sign-ins?month=${nextMonth}`} aria-label={`View ${formatMonth(nextMonth)}`}>
            <span>Next</span><span aria-hidden="true">→</span>
          </a>
        ) : (
          <span class="calendar-nav calendar-nav--disabled" aria-disabled="true"><span>Next</span><span aria-hidden="true">→</span></span>
        )}
      </header>

      {calendarIsLimited && (
        <p class="calendar-notice" role="status">
          This month has more than {ADMIN_RESULT_LIMIT} sign-ins. Daily counts are complete, but only the newest {ADMIN_RESULT_LIMIT} details are available here.
        </p>
      )}

      <div class="calendar-table-wrap">
        <table class="calendar-table">
          <caption class="sr-only">Volunteer sign-ins for {monthLabel}, Monday to Sunday</caption>
          <thead>
            <tr>
              {['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'].map((day) => (
                <th scope="col"><abbr title={day}>{day.slice(0, 3)}</abbr></th>
              ))}
            </tr>
          </thead>
          <tbody>
            {weeks.map((week) => (
              <tr>
                {week.days.map((day) => {
                  if (!day) return <td class="calendar-day calendar-day--outside" aria-hidden="true"></td>;
                  const count = countByDate.get(day.date) || 0;
                  const dayDialogId = `sign-in-day-${day.date}`;
                  return (
                    <td class:list={['calendar-day', { 'calendar-day--populated': count > 0 }]}>
                      {count > 0 ? (
                        <button
                          type="button"
                          class="calendar-day__button"
                          data-dialog-open={dayDialogId}
                          aria-haspopup="dialog"
                          aria-controls={dayDialogId}
                          aria-label={`${formatDate(day.date)}, ${count} ${count === 1 ? 'sign-in' : 'sign-ins'}`}
                        >
                          <time class="calendar-day__date" datetime={day.date}>{day.dayNumber}</time>
                          <span class="calendar-day__count"><strong>{count}</strong> <span>{count === 1 ? 'sign-in' : 'sign-ins'}</span></span>
                        </button>
                      ) : (
                        <time class="calendar-day__date" datetime={day.date}>{day.dayNumber}</time>
                      )}
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {calendarTotal === 0 && (
        <div class="calendar-empty">
          <h3>No sign-ins this month</h3>
          <p>Use Previous or Next to review another month.</p>
        </div>
      )}

      {counts.map((countRow) => {
        const dayRecords = recordsByDate.get(countRow.volunteer_date) || [];
        const dayDialogId = `sign-in-day-${countRow.volunteer_date}`;
        const dayTitleId = `${dayDialogId}-title`;
        const expectedCount = Number(countRow.sign_in_count);
        return (
          <dialog class="admin-dialog day-sign-ins-dialog" id={dayDialogId} aria-labelledby={dayTitleId}>
            <article class="admin-dialog__panel">
              <header class="admin-dialog__header">
                <div>
                  <p class="admin-dialog__eyebrow">{expectedCount} {expectedCount === 1 ? 'volunteer' : 'volunteers'}</p>
                  <h2 id={dayTitleId}>{formatDate(countRow.volunteer_date)}</h2>
                </div>
                <button class="admin-dialog__close" type="button" data-dialog-close aria-label="Close volunteer list">×</button>
              </header>
              <div class="admin-dialog__body day-sign-ins-dialog__body">
                {dayRecords.length > 0 ? (
                  <ul class="day-sign-ins-list">
                    {dayRecords.map((signIn) => (
                      <li>
                        <button
                          type="button"
                          data-dialog-open={`sign-in-${signIn.id}`}
                          aria-haspopup="dialog"
                          aria-controls={`sign-in-${signIn.id}`}
                          aria-label={`View full details for ${displayValue(signIn.full_name)}`}
                        >
                          <span class="day-sign-ins-list__name">
                            <strong>{displayValue(signIn.full_name)}</strong>
                            {isDemoSignInName(signIn.full_name) && <span class="demo-record-badge">Demo</span>}
                          </span>
                          <span class="day-sign-ins-list__meta">In {formatTime(signIn.signed_in_at)} · {signIn.signed_out_at ? `Out ${formatTime(signIn.signed_out_at)}${signIn.sign_out_method === 'automatic' ? ' (auto)' : ''}` : 'Still signed in'} <span aria-hidden="true">→</span></span>
                        </button>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="day-sign-ins-unavailable">Volunteer details are outside the current display limit.</p>
                )}
                {dayRecords.length < expectedCount && dayRecords.length > 0 && (
                  <p class="day-sign-ins-limit">Showing the newest {dayRecords.length} of {expectedCount} sign-ins for this day.</p>
                )}
              </div>
            </article>
          </dialog>
        );
      })}
    </section>
  ) : signIns.length === 0 && params.name ? (
    <section class="admin-state">
      <h2>No matching sign-ins</h2>
      <p>Try a different volunteer name.</p>
      <a class="admin-link-button" href="/admin/sign-ins?view=list">Clear search</a>
    </section>
  ) : signIns.length === 0 ? (
    <section class="admin-state">
      <h2>No volunteer sign-ins yet</h2>
      <p>New sign-ins will appear here.</p>
    </section>
  ) : (
    <div class="records-table-wrap">
      <table class="records-table">
        <caption class="sr-only">Volunteer sign-in records, newest first</caption>
        <thead>
          <tr>
            <th scope="col">Volunteer</th>
            <th scope="col">Phone</th>
            <th scope="col">Volunteer date</th>
            <th scope="col">Signed in</th>
            <th scope="col">Signed out</th>
            <th scope="col"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          {signIns.map((signIn) => {
            const dialogId = `sign-in-${signIn.id}`;
            return (
              <tr
                data-dialog-open={dialogId}
                tabindex="0"
                aria-haspopup="dialog"
                aria-controls={dialogId}
                aria-label={`View full details for ${displayValue(signIn.full_name)}`}
              >
                <td data-label="Volunteer">
                  <span class="record-name"><strong>{displayValue(signIn.full_name)}</strong>{isDemoSignInName(signIn.full_name) && <span class="demo-record-badge">Demo</span>}</span>
                </td>
                <td data-label="Phone" class="record-contact">{displayValue(signIn.phone)}</td>
                <td data-label="Volunteer date"><time datetime={signIn.volunteer_date}>{formatDate(signIn.volunteer_date)}</time></td>
                <td data-label="Signed in"><time datetime={signIn.signed_in_at}>{formatDateTime(signIn.signed_in_at)}</time></td>
                <td data-label="Signed out">
                  {signIn.signed_out_at ? (
                    <span class="sign-out-cell">
                      <time datetime={signIn.signed_out_at}>{formatTime(signIn.signed_out_at)}</time>
                      {signIn.sign_out_method === 'automatic'
                        ? <span class="attendance-badge attendance-badge--automatic" title="Not confirmed by the volunteer">Automatic</span>
                        : <span class="attendance-badge attendance-badge--signed-out">Confirmed</span>}
                    </span>
                  ) : <span class="attendance-badge attendance-badge--signed-in">Signed in</span>}
                </td>
                <td data-label="Details" class="record-actions">
                  <button
                    class="record-view-button"
                    type="button"
                    data-dialog-open={dialogId}
                    aria-haspopup="dialog"
                    aria-controls={dialogId}
                    aria-label={`View full details for ${displayValue(signIn.full_name)}`}
                  >View details</button>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )}

  {!loadError && signIns.map((signIn) => (
    <AdminRecordDialog
      id={`sign-in-${signIn.id}`}
      title={displayValue(signIn.full_name)}
      eyebrow={isDemoSignInName(signIn.full_name) ? 'Demo volunteer sign-in' : 'Volunteer sign-in'}
      groups={detailsFor(signIn)}
    />
  ))}
</AdminLayout>

<style is:global>
  .sign-ins-heading { align-items: center; }
  .sign-out-cell { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.45rem; }

  .view-switch {
    display: inline-flex;
    flex: 0 0 auto;
    padding: 0.25rem;
    border: 1px solid #d3dbd0;
    border-radius: 7px;
    background: #fff;
  }

  .view-switch a {
    min-width: 5.8rem;
    padding: 0.55rem 0.9rem;
    border-radius: 4px;
    color: #596556;
    font-size: 0.8rem;
    font-weight: 700;
    text-align: center;
  }

  .view-switch a:hover { color: #285f25; }
  .view-switch a[aria-current='page'] { background: #34752e; color: #fff; }
  .sign-in-search { grid-template-columns: minmax(15rem, 1fr) auto auto; }
  .record-name,
  .day-sign-ins-list__name { display: inline-flex; align-items: center; gap: 0.55rem; }

  .demo-record-badge {
    display: inline-flex;
    align-items: center;
    min-height: 1.35rem;
    padding: 0.1rem 0.42rem;
    border: 1px solid #d6b968;
    border-radius: 999px;
    background: #fff8de;
    color: #725813;
    font-size: 0.61rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }


  @media (max-width: 800px) {
    .sign-ins-heading { align-items: flex-start; }
    .sign-in-search { grid-template-columns: 1fr auto auto; }
  }

  @media (max-width: 520px) {
    .view-switch { width: 100%; }
    .view-switch a { flex: 1; }
    .sign-in-search { grid-template-columns: 1fr; }
  }
</style>
