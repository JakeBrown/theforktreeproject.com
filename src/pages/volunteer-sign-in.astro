---
import PageLayout from '../layouts/PageLayout.astro';
import VolunteerSignInForm from '../components/VolunteerSignInForm';
---

<PageLayout
  title="Volunteer Sign In — The Forktree Project"
  description="Sign in for your volunteer day at The Forktree Project."
  headerVariant="dark"
  norobots={true}
>
  <section class="volunteer-sign-in">
    <div class="volunteer-sign-in__intro">
      <p class="volunteer-sign-in__kicker">Welcome to Forktree</p>
      <h1>Volunteer sign in</h1>
      <p>Enter your details before starting your volunteer day.</p>
    </div>

    <div class="volunteer-sign-in__card">
      <VolunteerSignInForm client:load />
    </div>

    <div class="volunteer-sign-in__qr" aria-labelledby="volunteer-sign-in-qr-title">
      <p class="volunteer-sign-in__qr-kicker">Quick access</p>
      <h2 id="volunteer-sign-in-qr-title">Sign in on your phone</h2>
      <p>Scan this QR code to open the volunteer sign-in page.</p>
      <img
        src="/images/volunteer-sign-in-qr.svg"
        alt="QR code for the Forktree volunteer sign-in page"
        width="260"
        height="260"
        loading="lazy"
      />
      <a href="/images/volunteer-sign-in-qr.svg" download="forktree-volunteer-sign-in-qr.svg">
        Download QR code
      </a>
    </div>
  </section>
</PageLayout>

<style>
  .volunteer-sign-in {
    min-height: 100vh;
    padding: calc(var(--header-height) + 4rem) var(--space-md) var(--space-xl);
    background:
      radial-gradient(circle at 15% 15%, rgba(90, 158, 82, 0.12), transparent 34rem),
      #fafaf9;
  }

  .volunteer-sign-in__intro,
  .volunteer-sign-in__card,
  .volunteer-sign-in__qr {
    width: min(100%, 620px);
    margin-inline: auto;
  }

  .volunteer-sign-in__intro {
    margin-bottom: 2rem;
    text-align: center;
  }

  .volunteer-sign-in__kicker {
    margin: 0 0 0.65rem;
    color: #3a7d32;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .volunteer-sign-in h1 {
    margin-bottom: 0.8rem;
    color: #1f2a1f;
    font-size: clamp(2.35rem, 8vw, 4.25rem);
    line-height: 1.08;
  }

  .volunteer-sign-in__intro > p:last-child {
    margin: 0;
    color: #555d52;
    font-size: 1rem;
  }

  .volunteer-sign-in__card {
    padding: clamp(1.4rem, 5vw, 2.5rem);
    border: 1px solid #dde1da;
    border-radius: 4px;
    background: #fff;
    box-shadow: 0 18px 55px rgba(31, 42, 31, 0.09);
  }

  .volunteer-sign-in__qr {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 2rem;
    padding: clamp(1.5rem, 5vw, 2.5rem);
    border: 1px solid #dde1da;
    border-radius: 4px;
    background: #eef0eb;
    text-align: center;
  }

  .volunteer-sign-in__qr-kicker {
    margin: 0 0 0.5rem;
    color: #3a7d32;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .volunteer-sign-in__qr h2 {
    margin: 0 0 0.65rem;
    color: #1f2a1f;
    font-size: clamp(1.5rem, 5vw, 2rem);
  }

  .volunteer-sign-in__qr > p:not(.volunteer-sign-in__qr-kicker) {
    margin: 0 0 1.25rem;
    color: #555d52;
  }

  .volunteer-sign-in__qr img {
    width: min(260px, 100%);
    height: auto;
    padding: 0.5rem;
    background: #fff;
  }

  .volunteer-sign-in__qr a {
    margin-top: 1rem;
    color: #2d6927;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-transform: uppercase;
  }

  .volunteer-sign-in__qr a:hover,
  .volunteer-sign-in__qr a:focus-visible {
    color: #1f2a1f;
  }

  @media (max-width: 768px) {
    .volunteer-sign-in {
      padding: calc(var(--header-height) + 2rem) 1rem var(--space-lg);
    }

    .volunteer-sign-in__intro {
      margin-bottom: 1.5rem;
    }
  }
</style>
