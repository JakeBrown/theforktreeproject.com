---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  headerVariant?: 'light' | 'dark';
  headerTopGlass?: boolean;
  norobots?: boolean;
}

const { title, description, ogImage, headerVariant = 'light', headerTopGlass = false, norobots = false } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage} norobots={norobots}>
  <Header variant={headerVariant} topGlass={headerTopGlass} />
  <main>
    <slot />
  </main>
  <Footer />
</BaseLayout>
