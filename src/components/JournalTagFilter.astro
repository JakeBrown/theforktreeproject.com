---
import {
  getJournalPageHref,
  getJournalTagHref,
  journalTags,
} from '../data/journalTags';

interface Props {
  activeTag?: string | null;
  basePath?: string;
  tagCounts?: Record<string, number>;
  totalCount?: number;
}

const {
  activeTag = null,
  basePath = '/blog',
  tagCounts = {},
  totalCount = 0,
} = Astro.props;

const visibleTags = journalTags.filter((tag) => (tagCounts[tag.slug] ?? 0) > 0);
const allHref = getJournalPageHref(basePath, 1);
const panelId = `journal-topic-panel-${basePath.replace(/[^a-z0-9]+/gi, '-').replace(/^-|-$/g, '') || 'blog'}`;
---

<section class="tag-filter" aria-labelledby="tag-filter-heading" data-tag-filter>
  <div id="tag-filter-heading" class="tag-filter__heading">Explore by topic</div>
  <div class="tag-filter__intro">Browse the Forktree journal by theme, activity, and event.</div>

  <form class="tag-filter__search" action="/search" method="get" role="search">
    <label class="sr-only" for="journal-topic-search">Search the journal</label>
    <input id="journal-topic-search" name="q" type="search" placeholder="Search the journal" />
    <button type="submit">Search</button>
  </form>

  <div class="tag-filter__actions">
    <button
      class="tag-filter__toggle"
      type="button"
      aria-expanded="false"
      aria-controls={panelId}
      data-topic-toggle
      data-open-label="Hide topics"
    >
      <span data-topic-toggle-label>Show topics</span>
    </button>
  </div>

  <nav id={panelId} class="tag-filter__topics" aria-label="Filter posts by topic" hidden data-topic-panel>
    <a
      href={allHref}
      class:list={['tag-filter__chip', { 'is-active': !activeTag }]}
      aria-current={!activeTag ? 'page' : undefined}
    >
      All <span class="tag-filter__count">{totalCount}</span>
    </a>
    {visibleTags.map((tag) => (
      <a
        href={getJournalTagHref(tag.slug, basePath)}
        class:list={['tag-filter__chip', { 'is-active': activeTag === tag.slug }]}
        aria-current={activeTag === tag.slug ? 'page' : undefined}
      >
        {tag.label} <span class="tag-filter__count">{tagCounts[tag.slug]}</span>
      </a>
    ))}
  </nav>
</section>

<script>
  document.querySelectorAll('[data-tag-filter]').forEach((filter) => {
    const toggle = filter.querySelector('[data-topic-toggle]');
    const panel = filter.querySelector('[data-topic-panel]');
    const label = filter.querySelector('[data-topic-toggle-label]');

    if (!(toggle instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;

    const closedLabel = toggle.dataset.closedLabel || 'Show topics';
    const openLabel = toggle.dataset.openLabel || 'Hide topics';

    const setOpen = (isOpen: boolean) => {
      toggle.setAttribute('aria-expanded', String(isOpen));
      panel.hidden = !isOpen;
      if (label) label.textContent = isOpen ? openLabel : closedLabel;
    };

    setOpen(false);
    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
  });
</script>

<style>
  .tag-filter {
    margin-top: var(--space-md);
  }

  .tag-filter__heading {
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    margin-bottom: 0.4rem;
    text-transform: uppercase;
  }

  .tag-filter__intro {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0 auto var(--space-sm);
  }

  .tag-filter__search {
    display: grid;
    gap: 0.5rem;
    grid-template-columns: minmax(0, 1fr) auto;
    margin: 0 auto var(--space-sm);
    max-width: 320px;
    transition: max-width var(--transition-base);
  }

  .tag-filter__search:focus-within {
    max-width: 560px;
  }

  .tag-filter__search input {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font: inherit;
    min-width: 0;
    padding: 0.75rem 1rem;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .tag-filter__search input:focus {
    border-color: rgba(58, 125, 50, 0.45);
    box-shadow: 0 0 0 3px rgba(58, 125, 50, 0.1);
    outline: none;
  }

  .tag-filter__search button {
    background-color: var(--color-primary);
    border-radius: 999px;
    color: var(--color-text-light);
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    padding: 0.75rem 0;
    pointer-events: none;
    text-transform: uppercase;
    transition: background-color var(--transition-fast), max-width var(--transition-base), opacity var(--transition-fast), padding var(--transition-base), visibility var(--transition-fast);
    visibility: hidden;
    white-space: nowrap;
  }

  .tag-filter__search:focus-within button {
    max-width: 120px;
    opacity: 1;
    padding: 0.75rem 1rem;
    pointer-events: auto;
    visibility: visible;
  }

  .tag-filter__search button:hover {
    background-color: var(--color-primary-dark);
  }

  .tag-filter__actions {
    display: flex;
    justify-content: center;
    margin-top: 0.75rem;
  }

  .tag-filter__toggle {
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-secondary);
    display: inline-flex;
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 700;
    gap: 0.45rem;
    letter-spacing: 0.1em;
    line-height: 1;
    padding: 0.65rem 0.9rem;
    text-transform: uppercase;
    transition: background-color var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
  }

  .tag-filter__toggle::after {
    content: '+';
    font-size: 0.9rem;
    line-height: 0.7;
  }

  .tag-filter__toggle[aria-expanded='true'] {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-text-light);
  }

  .tag-filter__toggle[aria-expanded='true']::after {
    content: '−';
  }

  .tag-filter__toggle:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .tag-filter__toggle[aria-expanded='true']:hover {
    color: var(--color-text-light);
  }

  .tag-filter__topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    justify-content: center;
    margin-top: var(--space-sm);
  }

  .tag-filter__topics[hidden] {
    display: none;
  }

  .tag-filter__chip {
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-secondary);
    display: inline-flex;
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 600;
    gap: 0.35rem;
    letter-spacing: 0.08em;
    line-height: 1;
    padding: 0.55rem 0.8rem;
    text-transform: uppercase;
    transition: background-color var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
  }

  .tag-filter__chip:hover,
  .tag-filter__chip.is-active {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-text-light);
  }

  .tag-filter__count {
    opacity: 0.72;
  }

  @media (max-width: 640px) {
    .tag-filter__search {
      max-width: 260px;
    }

    .tag-filter__search:focus-within {
      max-width: none;
    }

    .tag-filter__topics {
      justify-content: flex-start;
    }
  }
</style>
