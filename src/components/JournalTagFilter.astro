---
import {
  getJournalPageHref,
  getJournalTagHref,
  journalTags,
} from '../data/journalTags';

interface Props {
  activeTag?: string | null;
  basePath?: string;
  tagCounts?: Record<string, number>;
  totalCount?: number;
}

const {
  activeTag = null,
  basePath = '/blog',
  tagCounts = {},
  totalCount = 0,
} = Astro.props;

const visibleTags = journalTags.filter((tag) => (tagCounts[tag.slug] ?? 0) > 0);
const allHref = getJournalPageHref(basePath, 1);
const panelId = `journal-topic-panel-${basePath.replace(/[^a-z0-9]+/gi, '-').replace(/^-|-$/g, '') || 'blog'}`;
---

<section class="tag-filter" aria-label="Journal search and topic filters" data-tag-filter>
  <div class="tag-filter__controls">
    <form class="tag-filter__search" action="/search" method="get" role="search">
      <label class="sr-only" for="journal-topic-search">Search the journal</label>
      <input id="journal-topic-search" name="q" type="search" placeholder="Search journal" />
      <button type="submit">Search</button>
    </form>

    <button
      class="tag-filter__toggle"
      type="button"
      aria-expanded="false"
      aria-controls={panelId}
      data-topic-toggle
      data-open-label="Hide topics"
    >
      <span data-topic-toggle-label>Show topics</span>
    </button>
  </div>

  <div id={panelId} class="tag-filter__topics" aria-hidden="true" inert data-topic-panel>
    <div class="tag-filter__heading">Explore by topic</div>
    <div class="tag-filter__intro">Browse the Forktree journal by theme, activity, and event.</div>

    <nav class="tag-filter__chips" aria-label="Filter posts by topic">
      <a
        href={allHref}
        class:list={['tag-filter__chip', { 'is-active': !activeTag }]}
        aria-current={!activeTag ? 'page' : undefined}
      >
        All <span class="tag-filter__count">{totalCount}</span>
      </a>
      {visibleTags.map((tag) => (
        <a
          href={getJournalTagHref(tag.slug, basePath)}
          class:list={['tag-filter__chip', { 'is-active': activeTag === tag.slug }]}
          aria-current={activeTag === tag.slug ? 'page' : undefined}
        >
          {tag.label} <span class="tag-filter__count">{tagCounts[tag.slug]}</span>
        </a>
      ))}
    </nav>
  </div>
</section>

<script>
  document.querySelectorAll('[data-tag-filter]').forEach((filter) => {
    const toggle = filter.querySelector('[data-topic-toggle]');
    const panel = filter.querySelector('[data-topic-panel]');
    const label = filter.querySelector('[data-topic-toggle-label]');

    if (!(toggle instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;

    const closedLabel = toggle.dataset.closedLabel || 'Show topics';
    const openLabel = toggle.dataset.openLabel || 'Hide topics';

    const setOpen = (isOpen: boolean) => {
      filter.classList.toggle('is-topics-open', isOpen);
      toggle.setAttribute('aria-expanded', String(isOpen));
      panel.setAttribute('aria-hidden', String(!isOpen));
      panel.toggleAttribute('inert', !isOpen);
      if (label) label.textContent = isOpen ? openLabel : closedLabel;
    };

    setOpen(false);
    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
  });
</script>

<style>
  .tag-filter {
    margin-top: var(--space-md);
  }

  .tag-filter__controls {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
  }

  .tag-filter__search {
    display: flex;
    gap: 0.45rem;
    margin: 0;
    max-width: 100%;
    width: 205px;
    transition: width 360ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tag-filter__search:focus-within {
    width: 480px;
  }

  .tag-filter__search input {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    flex: 1 1 auto;
    font: inherit;
    min-width: 0;
    padding: 0.65rem 0.9rem;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .tag-filter__search input:focus {
    border-color: rgba(58, 125, 50, 0.45);
    box-shadow: 0 0 0 3px rgba(58, 125, 50, 0.1);
    outline: none;
  }

  .tag-filter__search button {
    background-color: var(--color-primary);
    border-radius: 999px;
    color: var(--color-text-light);
    flex: 0 0 0;
    font-family: var(--font-heading);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    opacity: 0;
    overflow: hidden;
    padding: 0.65rem 0;
    pointer-events: none;
    text-transform: uppercase;
    transition: background-color var(--transition-fast), flex-basis 320ms cubic-bezier(0.22, 1, 0.36, 1), opacity 180ms ease, padding 320ms cubic-bezier(0.22, 1, 0.36, 1), visibility var(--transition-fast);
    visibility: hidden;
    white-space: nowrap;
  }

  .tag-filter__search:focus-within button {
    flex-basis: 92px;
    opacity: 1;
    padding: 0.65rem 0.9rem;
    pointer-events: auto;
    visibility: visible;
  }

  .tag-filter__search button:hover {
    background-color: var(--color-primary-dark);
  }

  .tag-filter__toggle {
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-secondary);
    display: inline-flex;
    font-family: var(--font-heading);
    font-size: 0.66rem;
    font-weight: 700;
    gap: 0.45rem;
    letter-spacing: 0.1em;
    line-height: 1;
    padding: 0.65rem 0.85rem;
    text-transform: uppercase;
    transition: background-color var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
  }

  .tag-filter__toggle::after {
    content: '+';
    font-size: 0.9rem;
    line-height: 0.7;
  }

  .tag-filter__toggle[aria-expanded='true'] {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-text-light);
  }

  .tag-filter__toggle[aria-expanded='true']::after {
    content: '−';
  }

  .tag-filter__toggle:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .tag-filter__toggle[aria-expanded='true']:hover {
    color: var(--color-text-light);
  }

  .tag-filter__topics {
    margin-top: 0;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
    text-align: center;
    transform: translateY(-0.35rem);
    transition: max-height 380ms cubic-bezier(0.22, 1, 0.36, 1), opacity 220ms ease, transform 320ms cubic-bezier(0.22, 1, 0.36, 1), margin-top 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tag-filter.is-topics-open .tag-filter__topics {
    margin-top: var(--space-sm);
    max-height: 720px;
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .tag-filter__heading {
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    margin-bottom: 0.4rem;
    text-transform: uppercase;
  }

  .tag-filter__intro {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0 auto var(--space-sm);
  }

  .tag-filter__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    justify-content: center;
  }

  .tag-filter__chip {
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-secondary);
    display: inline-flex;
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 600;
    gap: 0.35rem;
    letter-spacing: 0.08em;
    line-height: 1;
    padding: 0.55rem 0.8rem;
    text-transform: uppercase;
    transition: background-color var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
  }

  .tag-filter__chip:hover,
  .tag-filter__chip.is-active {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-text-light);
  }

  .tag-filter__count {
    opacity: 0.72;
  }

  @media (max-width: 640px) {
    .tag-filter__controls {
      gap: 0.5rem;
    }

    .tag-filter__search {
      max-width: 100%;
      width: 190px;
    }

    .tag-filter__search:focus-within {
      width: 340px;
    }

    .tag-filter__chips {
      justify-content: flex-start;
    }
  }
</style>
