---
---

<footer class="footer">
  <div class="footer__inner">

    <div class="footer__col">
      <nav class="footer__links">
        <a href="/supporters">Supporters</a>
        <a href="mailto:hello@theforktreeproject.com?subject=Forktree%20Website%20Enquiry">hello@theforktreeproject.com</a>
      </nav>
      <a
        href="https://www.instagram.com/forktreeproject/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Follow us on Instagram"
        class="footer__social"
      >
        <svg width="20" height="20" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" xmlns="http://www.w3.org/2000/svg">
          <rect x="2" y="2" width="60" height="60" rx="16" />
          <circle cx="32" cy="32" r="16" />
          <circle cx="50" cy="14" r="4" fill="currentColor" stroke="none" />
        </svg>
      </a>
    </div>

    <div class="footer__col footer__col--right">
      <a href="https://www.acnc.gov.au/" target="_blank" rel="noopener noreferrer" class="footer__badge">
        <img
          src="/images/acnc-badge.png"
          alt="ACNC Registered Charity"
          width="120"
          height="120"
          loading="lazy"
        />
      </a>
    </div>

  </div>
</footer>

<style>
  .footer {
    padding: var(--space-xl) 0 var(--space-lg);
    background: #1f2a1f;
    color: rgba(255, 255, 255, 0.8);
  }

  .footer__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 100px;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-lg);
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .footer__col--right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer__links a {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.7);
    transition: opacity var(--transition-fast);
  }

  .footer__links a:hover {
    opacity: 0.6;
  }

  .footer__badge img {
    opacity: 0.8;
    transition: opacity var(--transition-fast);
  }

  .footer__badge:hover img {
    opacity: 1;
  }

  .footer__social {
    color: rgba(255, 255, 255, 0.7);
    transition: opacity var(--transition-fast);
    display: flex;
    align-items: center;
  }

  .footer__social:hover {
    opacity: 0.6;
  }

  @media (max-width: 768px) {
    .footer__inner {
      grid-template-columns: 1fr;
      padding: 0 30px;
      text-align: center;
    }

    .footer__col--right {
      justify-content: center;
    }

    .footer__links {
      align-items: center;
    }
  }
</style>
