---
---

<footer class="footer">
  <div class="footer__inner">

    <div class="footer__col footer__col--contact">
      <p class="footer__kicker">Get in touch</p>
      <p class="footer__blurb">We&rsquo;d love to hear from you.</p>
      <nav class="footer__links">
        <a href="mailto:hello@theforktreeproject.com?subject=Forktree%20Website%20Enquiry">hello@theforktreeproject.com</a>
      </nav>
      <a
        href="https://www.instagram.com/forktreeproject/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Follow us on Instagram"
        class="footer__social"
      >
        <svg width="20" height="20" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" xmlns="http://www.w3.org/2000/svg">
          <rect x="2" y="2" width="60" height="60" rx="16" />
          <circle cx="32" cy="32" r="16" />
          <circle cx="50" cy="14" r="4" fill="currentColor" stroke="none" />
        </svg>
      </a>
    </div>

    <div class="footer__col footer__col--supporters">
      <p class="footer__kicker">With thanks to</p>
      <h3 class="footer__heading">Our Supporters</h3>
      <p class="footer__blurb">The organisations and individuals making our work possible.</p>
      <a href="/supporters" class="footer__cta">Meet our supporters &rarr;</a>
    </div>

    <div class="footer__col footer__col--badge">
      <a href="https://www.acnc.gov.au/" target="_blank" rel="noopener noreferrer" class="footer__badge">
        <img
          src="/images/acnc-badge.png"
          alt="ACNC Registered Charity"
          width="120"
          height="120"
          loading="lazy"
        />
      </a>
    </div>

  </div>
</footer>

<style>
  .footer {
    padding: var(--space-xl) 0 var(--space-lg);
    background: #1f2a1f;
    color: rgba(255, 255, 255, 0.8);
  }

  .footer__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 100px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-xl);
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .footer__col--contact {
    align-items: flex-start;
    gap: 0.6rem;
  }

  .footer__col--contact .footer__blurb {
    text-align: left;
  }

  .footer__col--contact .footer__links {
    margin-top: 0.4rem;
  }

  .footer__col--contact .footer__social {
    margin-top: 0.2rem;
  }

  .footer__col--supporters {
    align-items: center;
    text-align: center;
    gap: 0.6rem;
  }

  .footer__col--badge {
    align-items: flex-end;
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer__links a {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.7);
    transition: opacity var(--transition-fast);
  }

  .footer__links a:hover {
    opacity: 0.6;
  }

  .footer__kicker {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 2.4px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin: 0;
  }

  .footer__heading {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 700;
    line-height: 1.1;
    color: #fff;
    margin: 0;
  }

  .footer__blurb {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.75);
    max-width: 28ch;
    margin: 0;
  }

  .footer__cta {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: white;
    border: 2px solid white;
    padding: 13px 26px;
    text-decoration: none;
    transition: all var(--transition-normal);
    margin-top: 0.5rem;
  }

  .footer__cta:hover {
    background-color: white;
    color: #1f2a1f;
  }

  .footer__badge img {
    opacity: 0.8;
    transition: opacity var(--transition-fast);
  }

  .footer__badge:hover img {
    opacity: 1;
  }

  .footer__social {
    color: rgba(255, 255, 255, 0.7);
    transition: opacity var(--transition-fast);
    display: flex;
    align-items: center;
  }

  .footer__social:hover {
    opacity: 0.6;
  }

  @media (max-width: 900px) {
    .footer__inner {
      grid-template-columns: 1fr;
      padding: 0 30px;
      gap: var(--space-lg);
      text-align: center;
    }

    .footer__col--contact,
    .footer__col--supporters,
    .footer__col--badge {
      align-items: center;
    }

    .footer__col--supporters {
      order: -1;
    }

    .footer__links {
      align-items: center;
    }
  }
</style>
