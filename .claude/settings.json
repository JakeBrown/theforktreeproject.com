{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm run *)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(npx tsc:*)",
      "Bash(npx astro:*)",
      "Bash(npx wrangler dev:*)",
      "Bash(npx wrangler types:*)",
      "Bash(npx wrangler tail:*)",
      "Bash(npx wrangler whoami)"
    ]
  }
}
